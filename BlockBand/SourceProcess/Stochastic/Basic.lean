module
public import BlockBand.SourceProcess.FiniteDriverCompletion.FullNativeOperator
public import Mathlib.Probability.Process.Stopping
set_option autoImplicit false
@[expose] public section
noncomputable section

/-!
# Stochastic calculus: base objects

Stopping times and Itô processes are taken with respect to the null-augmented
filtration `F_t ∨ N` (`N` = ambient sets of `driverLaw μ`-measure zero). This is
needed because the integral processes are continuous only almost surely, so their
hitting times are stopping times only after augmentation. Martingales are still stated
for the raw filtration where they are constructed.

These objects serve the stochastic steps of the finite Gram law, the dual diffusion of the dual
boundary lemma and the duality proof of the transmission law.
-/

namespace BlockBand.SourceProcess.Stochastic
open MeasureTheory ProbabilityTheory Filter
open scoped NNReal ENNReal
open BlockBand.SourceProcess.FiniteDriverIntegration
open BlockBand.SourceProcess.FiniteDriverIntegration.ContinuousIto
open BlockBand.SourceProcess.FiniteDriverCompletion

section Augmentation
variable {Ω : Type*} [mΩ : MeasurableSpace Ω]

/-- The σ-algebra generated by the ambient-measurable `P`-null sets. -/
@[instance_reducible] def nullSigma (P : Measure Ω) : MeasurableSpace Ω :=
  MeasurableSpace.generateFrom {N | MeasurableSet N ∧ P N = 0}

theorem nullSigma_le (P : Measure Ω) : nullSigma P ≤ mΩ :=
  MeasurableSpace.generateFrom_le fun _ hN => hN.1

/-- Null augmentation `t ↦ F_t ∨ N` of a real-time filtration. It stays below the ambient
σ-algebra (no completion of the ambient space is used). -/
def augmentedFiltration (𝓕 : Filtration ℝ≥0 mΩ) (P : Measure Ω) : Filtration ℝ≥0 mΩ where
  seq t := 𝓕 t ⊔ nullSigma P
  mono' _ _ hst := sup_le_sup_right (𝓕.mono hst) _
  le' t := sup_le (𝓕.le t) (nullSigma_le P)

theorem le_augmentedFiltration (𝓕 : Filtration ℝ≥0 mΩ) (P : Measure Ω) (t : ℝ≥0) :
    𝓕 t ≤ augmentedFiltration 𝓕 P t :=
  le_sup_left

end Augmentation

variable {S κ : Type*} [MeasurableSpace S] [Fintype κ]
variable (μ : Measure S) [IsProbabilityMeasure μ]

/-- The augmented driver filtration `F_t ∨ N` under `driverLaw μ`. -/
abbrev driverAugmented : Filtration ℝ≥0 (inferInstance : MeasurableSpace (DriverSample S κ)) :=
  augmentedFiltration (commonWienerFiltration S κ) (driverLaw (κ := κ) μ)

/-- A finite family of raw integrands on `(0,T] × Ω` that is square integrable for
`dt ⊗ driverLaw μ` and a.e. equal to a function measurable for the raw enlarged predictable
σ-algebra (generated by `(s,t] × A`, `A ∈ F_s`, and `{0} × A`, `A ∈ F_0`). -/
def NativeIntegrand (T : ℝ≥0) (g : κ → ℝ × DriverSample S κ → ℝ) : Prop :=
  ∀ a, AEStronglyMeasurable[predictableSpace (enlargedPredictableFiltration (S := S) (κ := κ))]
      (g a) (timeProbMeasure T (driverLaw (κ := κ) μ)) ∧
    MemLp (g a) 2 (timeProbMeasure T (driverLaw (κ := κ) μ))

variable {μ}

/-- The predictable `L²` family represented by an integrand. -/
def NativeIntegrand.family {T : ℝ≥0} {g : κ → ℝ × DriverSample S κ → ℝ}
    (hg : NativeIntegrand μ T g) : PredictableFamily (S := S) (κ := κ) (μ := μ) T :=
  WithLp.toLp 2 fun a => ⟨(hg a).2.toLp (g a), (hg a).1.congr (hg a).2.coeFn_toLp.symm⟩

/-- The terminal Itô integral `∑_a ∫_0^T g_a dW^a` of an integrand
(the adopted isometry `fullNativeIntegral`, as an `L²` class). -/
def nativeIntegralOf {T : ℝ≥0} {g : κ → ℝ × DriverSample S κ → ℝ}
    (hg : NativeIntegrand μ T g) : Lp ℝ 2 (driverLaw (κ := κ) μ) :=
  fullNativeIntegral (κ := κ) μ T hg.family

/-- The integrand restricted to the stochastic interval `{(s,x) : s ≤ σ x}`. Times are
compared in `WithTop ℝ≥0`; `σ = ⊤` keeps the whole integrand. -/
def stopIntegrand (σ : DriverSample S κ → WithTop ℝ≥0) (g : κ → ℝ × DriverSample S κ → ℝ) :
    κ → ℝ × DriverSample S κ → ℝ :=
  fun a p => if ((p.1.toNNReal : ℝ≥0) : WithTop ℝ≥0) ≤ σ p.2 then g a p else 0

variable (μ)

/-- **Continuous stochastic integral, identified with the stopped-integrand integral.**

For every horizon `T` and integrand `g` on `(0,T]` there is a real process `X` on
the driver space such that
* `X` is raw-adapted, a raw-filtration martingale, `L²` at every time, with `X 0 = 0`
  for every sample and almost surely continuous paths;
* for every stopping time `τ` of the *augmented* filtration and every deterministic
  time `u`, the stopped integrand `g · 1{s ≤ u ∧ τ}` is again an integrand on
  `(0,T]`, and `X_{u ∧ τ}` equals its terminal integral almost surely.

Taking `τ = ⊤`, `u ≥ T` gives the terminal identity `X_T = ∫_0^T g dW`; taking `τ = ⊤`
gives the timewise identity with `g 1_{(0,u]}`. Measure: `driverLaw μ`; norm: `L²`; no
dimension constants. Used for every localization in the finite Gram law and the dual boundary
lemma. -/
def ContinuousStoppedIntegral : Prop :=
  ∀ (T : ℝ≥0) (g : κ → ℝ × DriverSample S κ → ℝ), NativeIntegrand μ T g →
    ∃ X : ℝ≥0 → DriverSample S κ → ℝ,
      (∀ u, Measurable[commonWienerFiltration S κ u] (X u)) ∧
      Martingale X (commonWienerFiltration S κ) (driverLaw (κ := κ) μ) ∧
      (∀ u, MemLp (X u) 2 (driverLaw (κ := κ) μ)) ∧
      (∀ x, X 0 x = 0) ∧
      (∀ᵐ x ∂driverLaw (κ := κ) μ, Continuous fun u => X u x) ∧
      ∀ (τ : DriverSample S κ → WithTop ℝ≥0), IsStoppingTime (driverAugmented (κ := κ) μ) τ →
        ∀ u : ℝ≥0, ∃ hs : NativeIntegrand μ T (stopIntegrand (fun x => min (u : WithTop ℝ≥0) (τ x)) g),
          stoppedProcess X τ u =ᵐ[driverLaw (κ := κ) μ] (nativeIntegralOf hs : DriverSample S κ → ℝ)

end BlockBand.SourceProcess.Stochastic
