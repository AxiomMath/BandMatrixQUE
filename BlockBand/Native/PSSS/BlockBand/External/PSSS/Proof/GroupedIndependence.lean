module

public import Mathlib.Probability.HasLaw

/-!
# Independence under finite disjoint grouping

This module proves a general closure principle missing from the probability API:
a mutually independent family remains mutually independent after its indices are
partitioned into pairwise-disjoint finite packets and each packet is processed
by a measurable function.  The proof works at the level of generated
sigma-algebras and uses independence of the suprema over disjoint index sets.
-/

set_option autoImplicit false

@[expose] public section
noncomputable section

namespace ProbabilityTheory

open MeasureTheory

variable {Ω ι κ : Type*} {mΩ : MeasurableSpace Ω}

/-- The sigma-algebra generated by the members of `m` whose indices lie in `s`. -/
abbrev packetSigma (m : ι → MeasurableSpace Ω) (s : Set ι) : MeasurableSpace Ω :=
  ⨆ i ∈ s, m i

/-- Pairwise-disjoint packets of an independent family generate a mutually
independent family of sigma-algebras. -/
theorem iIndep_packetSigma {μ : Measure Ω} [IsProbabilityMeasure μ]
    {m : ι → MeasurableSpace Ω} (hm_le : ∀ i, m i ≤ mΩ)
    (hm : iIndep m μ) (packet : κ → Set ι)
    (hpacket : Set.Pairwise Set.univ fun a b => Disjoint (packet a) (packet b)) :
    iIndep (fun a => packetSigma m (packet a)) μ := by
  rw [iIndep_iff_iIndepSets]
  rw [iIndepSets_iff]
  intro s f hf
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | @insert a s ha ih =>
      have hfa : MeasurableSet[packetSigma m (packet a)] (f a) := hf a (by simp)
      have hfs : ∀ i ∈ s, MeasurableSet[packetSigma m (packet i)] (f i) := by
        intro i hi
        exact hf i (by simp [hi])
      have hdisj : Disjoint (packet a) (⋃ i ∈ (s : Set κ), packet i) := by
        rw [Set.disjoint_iUnion_right]
        intro i
        rw [Set.disjoint_iUnion_right]
        intro hi
        apply hpacket (Set.mem_univ a) (Set.mem_univ i)
        intro hai
        subst i
        exact ha hi
      have hind : Indep (packetSigma m (packet a))
          (packetSigma m (⋃ i ∈ (s : Set κ), packet i)) μ := by
        exact indep_iSup_of_disjoint hm_le hm hdisj
      have hrest : MeasurableSet[packetSigma m (⋃ i ∈ (s : Set κ), packet i)]
          (⋂ i ∈ s, f i) := by
        apply s.measurableSet_biInter
        intro i hi
        apply (show packetSigma m (packet i) ≤
            packetSigma m (⋃ i ∈ (s : Set κ), packet i) from ?_) _ (hfs i hi)
        unfold packetSigma
        apply iSup₂_le
        intro x hx
        apply le_iSup_of_le x
        apply le_iSup_of_le
          (Set.mem_iUnion_of_mem i (Set.mem_iUnion_of_mem (by simpa using hi) hx))
        exact le_rfl
      have hmul : μ (f a ∩ ⋂ i ∈ s, f i) =
          μ (f a) * μ (⋂ i ∈ s, f i) :=
        (indepSet_iff_measure_inter_eq_mul
          ((show packetSigma m (packet a) ≤ mΩ from
            iSup₂_le fun i _ => hm_le i) _ hfa)
          ((show packetSigma m (⋃ i ∈ (s : Set κ), packet i) ≤ mΩ from
            iSup₂_le fun i _ => hm_le i) _ hrest) μ).mp
          (hind.indepSet_of_measurableSet hfa hrest)
      rw [Finset.set_biInter_insert, Finset.prod_insert ha, hmul, ih hfs]

/-- Mutual independence is preserved when every generated sigma-algebra is
replaced by a smaller one. -/
theorem iIndep.mono {μ : Measure Ω} {m n : κ → MeasurableSpace Ω}
    (h : iIndep m μ) (hnm : ∀ i, n i ≤ m i) :
    iIndep n μ := by
  rw [iIndep_iff_iIndepSets] at h ⊢
  rw [iIndepSets_iff] at h ⊢
  intro s f hf
  exact h s fun i hi => hnm i _ (hf i hi)

/-- A mutually independent measurable family remains mutually independent
after it is collected into pairwise-disjoint packets.  Empty packets are
allowed. -/
theorem iIndepFun.group_packets
    {μ : Measure Ω} [IsProbabilityMeasure μ]
    {β : ι → Type*} {mβ : ∀ i, MeasurableSpace (β i)}
    {f : ∀ i, Ω → β i} (hf_indep : iIndepFun f μ)
    (hf_meas : ∀ i, Measurable (f i))
    (packet : κ → Set ι)
    (hpacket : Set.Pairwise Set.univ fun a b => Disjoint (packet a) (packet b)) :
    iIndepFun (fun a ω (i : packet a) => f i ω) μ := by
  let scalarSigma : ι → MeasurableSpace Ω :=
    fun i => (mβ i).comap (f i)
  have hscalar_le : ∀ i, scalarSigma i ≤ mΩ := by
    intro i
    exact (hf_meas i).comap_le
  have hscalar : iIndep scalarSigma μ := by
    exact (iIndepFun_iff_iIndep mβ f μ).mp hf_indep
  have hgroup : iIndep (fun a => packetSigma scalarSigma (packet a)) μ :=
    iIndep_packetSigma hscalar_le hscalar packet hpacket
  rw [iIndepFun_iff_iIndep]
  apply hgroup.mono
  intro a
  have hmeas : Measurable[packetSigma scalarSigma (packet a)]
      (fun ω (i : packet a) => f i ω) := by
    refine (@measurable_pi_iff Ω (packet a) (fun i => β i)
      (packetSigma scalarSigma (packet a)) (fun i => mβ i) _).2 ?_
    intro i
    refine (@measurable_iff_comap_le Ω (β i)
      (packetSigma scalarSigma (packet a)) (mβ i) (f i)).2 ?_
    unfold packetSigma
    apply le_iSup_of_le (i : ι)
    apply le_iSup_of_le i.2
    exact le_rfl
  exact hmeas.comap_le

/-- Measurable processing inside each packet preserves the grouped mutual
independence. -/
theorem iIndepFun.group_packets_comp
    {μ : Measure Ω} [IsProbabilityMeasure μ]
    {β : ι → Type*} {mβ : ∀ i, MeasurableSpace (β i)}
    {f : ∀ i, Ω → β i} (hf_indep : iIndepFun f μ)
    (hf_meas : ∀ i, Measurable (f i))
    (packet : κ → Set ι)
    (hpacket : Set.Pairwise Set.univ fun a b => Disjoint (packet a) (packet b))
    {γ : κ → Type*} {mγ : ∀ a, MeasurableSpace (γ a)}
    (g : ∀ a, (∀ i : packet a, β i) → γ a)
    (hg : ∀ a, Measurable (g a)) :
    iIndepFun (fun a ω => g a (fun i => f i ω)) μ := by
  exact (hf_indep.group_packets hf_meas packet hpacket).comp g hg

end ProbabilityTheory
