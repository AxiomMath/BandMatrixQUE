module

public import BlockBand.Transmission.LawDuality.Sigma

/-!
# Determination: the ratio transforms determine the law of a random finite measure

* `theta ν = (F_{x_k,0}(ν))_k ∈ [0,1]^ℕ`, `x_k = 1/(k+2)`; `measurable_theta`;
  **`le_comap_theta`**: the Giry σ-algebra of `FiniteMeasure [0,1]` is `≤ comap theta`.
* `thetaAlg`: the (star) subalgebra of `C_b([0,1]^ℕ)` generated by the coordinates; it separates
  points (`thetaAlg_separatesPoints`). Its monomials pulled back by `theta` are the ratios
  `F_{x,0}` with repeated `x_k` (`prod_theta`).
* **`map_eq_of_sameRatioTransforms`**: two measurable random finite measures on `[0,1]` (on any
  probability spaces) with the same `E F_{x,y}` for all ordered interior `(x, y)` have the same
  law. Proof: `integral_ratio_zero_eq` (`y ↓ 0`, repetitions) → equal integrals on `thetaAlg` →
  equal laws of `theta ∘ ν` on the Polish cube
  (`ext_of_forall_mem_subalgebra_integral_eq_of_polish`)
  → equal laws of `ν` (`le_comap_theta`).

The statement is unconditional and holds for **every** random finite measure on `[0,1]` (mass
at `0` included); `IsTransmissionLimit` is used only for `P(μ_t ∈ ·)` being a law.
-/

set_option autoImplicit false

@[expose] public section
noncomputable section

namespace BlockBand.Transmission.LawDuality

open MeasureTheory ProbabilityTheory Filter Topology Set
open BlockBand.Internal.Contracts.TransmissionPath BlockBand.Internal.Contracts.TransmissionLaws
open BlockBand.Transmission.DualBoundary
open scoped NNReal ENNReal BoundedContinuousFunction

/-- The cube `[0,1]^ℕ`. -/
abbrev Cube := ℕ → unitInterval

/-- `θ(ν) = (F_{x_k,0}(ν))_k`. -/
def theta (ν : FiniteMeasure unitInterval) : Cube := fun k =>
  ⟨transmissionRatio ![evalPoint k] ![0] ν,
    (transmissionRatio_mem (evalPoint_pos k).le le_rfl zero_lt_one ν).1.le,
    (transmissionRatio_mem (evalPoint_pos k).le le_rfl zero_lt_one ν).2⟩

theorem measurable_theta : Measurable theta :=
  Measurable.of_eval fun k =>
    (measurable_transmissionRatio (evalPoint_pos k).le le_rfl zero_lt_one).subtype_mk

/-- **The Giry σ-algebra is generated by `θ`.** -/
theorem le_comap_theta :
    (inferInstance : MeasurableSpace (FiniteMeasure unitInterval)) ≤
      MeasurableSpace.comap theta inferInstance := by
  have h : ∀ k, Measurable[MeasurableSpace.comap theta inferInstance]
      fun ν : FiniteMeasure unitInterval => logTransform (evalPoint k) (id ν) := by
    intro k
    have e : (fun ν : FiniteMeasure unitInterval => logTransform (evalPoint k) (id ν)) =
        fun ν => -Real.log ((theta ν k : unitInterval) : ℝ) := by
      funext ν
      simp only [id, theta, transmissionRatio_single_zero, Real.log_exp, neg_neg]
    rw [e]
    exact (Real.measurable_log.comp (measurable_subtype_coe.comp
      ((measurable_pi_apply k).comp (comap_measurable theta)))).neg
  have hm := @measurable_of_logTransform (FiniteMeasure unitInterval)
    (MeasurableSpace.comap theta inferInstance) id h
  simpa [MeasurableSpace.comap_id] using measurable_iff_comap_le.1 hm

/-- The coordinate `z ↦ z_k` of the cube as a bounded continuous function. -/
def coordBCF (k : ℕ) : Cube →ᵇ ℝ :=
  BoundedContinuousFunction.mkOfCompact
    ⟨fun z => (z k : ℝ), continuous_subtype_val.comp (continuous_apply k)⟩

/-- The subalgebra of `C_b([0,1]^ℕ)` generated by the coordinates. -/
def thetaAlg : StarSubalgebra ℝ (Cube →ᵇ ℝ) :=
  { Algebra.adjoin ℝ (Set.range coordBCF) with
    star_mem' := fun {a} ha => by
      have : star a = a := by ext z; simp
      rw [this]; exact ha }

theorem mem_thetaAlg {g : Cube →ᵇ ℝ} :
    g ∈ thetaAlg ↔ g ∈ Submodule.span ℝ (Submonoid.closure (Set.range coordBCF) : Set _) := by
  rw [← Algebra.adjoin_eq_span]; rfl

theorem thetaAlg_separatesPoints :
    (thetaAlg.map (BoundedContinuousFunction.toContinuousMapStarₐ ℝ)).SeparatesPoints := by
  intro z z' hne
  obtain ⟨k, hk⟩ := Function.ne_iff.1 hne
  refine ⟨_, ⟨BoundedContinuousFunction.toContinuousMapStarₐ ℝ (coordBCF k),
    StarSubalgebra.mem_map.2 ⟨coordBCF k, ?_, rfl⟩, rfl⟩, ?_⟩
  · rw [mem_thetaAlg]
    exact Submodule.subset_span (Submonoid.subset_closure ⟨k, rfl⟩)
  · intro e
    exact hk (Subtype.ext e)

/-- A monomial in the coordinates is a product `Π_j z_{k_j}`. -/
theorem list_prod_coord (l : List (Cube →ᵇ ℝ)) (hl : ∀ y ∈ l, y ∈ Set.range coordBCF) :
    ∃ (n : ℕ) (k : Fin n → ℕ), ∀ z, l.prod z = ∏ j, (z (k j) : ℝ) := by
  induction l with
  | nil => exact ⟨0, Fin.elim0, fun z => by simp⟩
  | cons a l ih =>
    obtain ⟨n, k, hk⟩ := ih fun y hy => hl y (List.mem_cons_of_mem a hy)
    obtain ⟨k0, rfl⟩ := hl a List.mem_cons_self
    refine ⟨n + 1, Fin.cons k0 k, fun z => ?_⟩
    rw [List.prod_cons, BoundedContinuousFunction.mul_apply, hk, Fin.prod_univ_succ]
    simp [coordBCF]

/-- The pulled-back monomial is a ratio `F_{x,0}` with `x_j = x_{k_j}`. -/
theorem prod_theta {n : ℕ} (k : Fin n → ℕ) (ν : FiniteMeasure unitInterval) :
    ∏ j, ((theta ν (k j) : unitInterval) : ℝ) =
      transmissionRatio (fun j => evalPoint (k j)) (fun _ => 0) ν := by
  rw [transmissionRatio_eq_prod (isRatioRange_zero fun j => (evalPoint_pos (k j)).le)]
  rfl

variable {Ω Ω' : Type*} [MeasurableSpace Ω] [MeasurableSpace Ω']

theorem integral_map_theta (g : Cube →ᵇ ℝ) {Q : Measure Ω} {ξ : Ω → FiniteMeasure unitInterval}
    (hξ : Measurable ξ) : ∫ z, g z ∂(Q.map (theta ∘ ξ)) = ∫ ω, g (theta (ξ ω)) ∂Q :=
  integral_map (measurable_theta.comp hξ).aemeasurable g.continuous.aestronglyMeasurable

/-- **Equal ratio transforms give equal laws.** -/
theorem map_eq_of_sameRatioTransforms {P : Measure Ω} [IsProbabilityMeasure P]
    {ν : Ω → FiniteMeasure unitInterval} (hν : Measurable ν) {P' : Measure Ω'}
    [IsProbabilityMeasure P'] {ν' : Ω' → FiniteMeasure unitInterval} (hν' : Measurable ν')
    (h : SameRatioTransforms P ν P' ν') : P.map ν = P'.map ν' := by
  have hm := measurable_theta.comp hν
  have hm' := measurable_theta.comp hν'
  have heq : ∀ g ∈ thetaAlg, ∫ z, g z ∂(P.map (theta ∘ ν)) = ∫ z, g z ∂(P'.map (theta ∘ ν')) := by
    intro g hg
    rw [mem_thetaAlg] at hg
    induction hg using Submodule.span_induction with
    | mem g hg =>
      obtain ⟨l, hl, rfl⟩ := Submonoid.exists_list_of_mem_closure hg
      obtain ⟨n, k, hk⟩ := list_prod_coord l hl
      rw [integral_map_theta _ hν, integral_map_theta _ hν']
      simp_rw [hk, prod_theta]
      exact integral_ratio_zero_eq hν hν' h _ fun j => (evalPoint_pos (k j)).le
    | zero => simp
    | add f g _ _ hf hg =>
      simp only [BoundedContinuousFunction.coe_add, Pi.add_apply]
      rw [integral_add (f.integrable _) (g.integrable _),
        integral_add (f.integrable _) (g.integrable _), hf, hg]
    | smul c f _ hf =>
      simp only [BoundedContinuousFunction.coe_smul]
      rw [integral_smul, integral_smul, hf]
  have hΘ : P.map (theta ∘ ν) = P'.map (theta ∘ ν') :=
    ext_of_forall_mem_subalgebra_integral_eq_of_polish thetaAlg_separatesPoints heq
  ext s hs
  obtain ⟨B, hB, rfl⟩ := MeasurableSpace.measurableSet_comap.1 (le_comap_theta s hs)
  rw [Measure.map_apply hν (measurable_theta hB), Measure.map_apply hν' (measurable_theta hB)]
  have : (P.map (theta ∘ ν)) B = (P'.map (theta ∘ ν')) B := by rw [hΘ]
  rwa [Measure.map_apply hm hB, Measure.map_apply hm' hB] at this

/-- **The `determining` field of `TransmissionLawContract`**: at every `t > 0`, a measurable
random finite measure `ν` with the same ratio transforms `E F_{x,y}` as `μ_t` has the law of `μ_t`. -/
theorem determining_holds : ∀ b : ℝ, 0 < b → b < 1 / 2 → ∀ E : ℝ, -2 < E → E < 2 →
    ∀ κ : ℝ → ℝ, IsAbsorptionProfile κ →
    ∀ (Ω : Type) (_ : MeasurableSpace Ω) (P : Measure Ω)
      (μ : ℝ → Ω → FiniteMeasure unitInterval), IsTransmissionLimit b E κ P μ →
    ∀ t : ℝ, 0 < t →
    ∀ (Ω' : Type) (_ : MeasurableSpace Ω') (P' : Measure Ω')
      (ν : Ω' → FiniteMeasure unitInterval), IsProbabilityMeasure P' → Measurable ν →
      (∀ (p : ℕ) (x y : Fin p → ℝ), IsRatioParameter x y →
        ∫ ω, transmissionRatio x y (ν ω) ∂P' = ∫ ω, transmissionRatio x y (μ t ω) ∂P) →
      P'.map ν = P.map (μ t) := by
  intro b _ _ E _ _ κ _ Ω _ P μ hlim t ht Ω' _ P' ν hP' hν heq
  have := hlim.prob
  exact map_eq_of_sameRatioTransforms hν (hlim.measurable t ht) heq

end BlockBand.Transmission.LawDuality
