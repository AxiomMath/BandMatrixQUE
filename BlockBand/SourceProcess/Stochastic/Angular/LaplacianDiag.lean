module

public import BlockBand.SourceProcess.Stochastic.Angular.Offdiag

/-!
# Complex angular martingale problem: the Laplacian identity `ArrayLaplacianDiag`

Proof. The coordinate trace of `D²F(y)` equals its trace in the complete family
`w_x = hermVec(U E_x U*)` (`trace_bilin_eq_of_complete`, `complete_conjVec`), `U` the eigenvector
unitary. For `x = (p, p)`, `w_x = hermVec P_p` and the term vanishes (`fderiv2_arrayFn_proj`).
For `p < q`, `w_{(p,q)}` and `w_{(q,p)}` are the directions of the rotation curves generated by
`jX`, `jY`, so by `offdiag_core` `2(λ_p - λ_q)² D²F[w, w]` is the pair term
`D²f₀[XZ, XZ] + Df₀[X²Z]` (resp. `Y`). Summing, `∑ = ∑_{p<q} (X² + Y²) f₀ / (2(λ_p - λ_q)²)`,
which is `2N · ¼ ∑_{p<q} c_pq (X² + Y²) f₀`.
-/

set_option autoImplicit false

@[expose] public section
noncomputable section

namespace BlockBand.SourceProcess.Stochastic.ComplexAngular
open Matrix Filter Topology
open scoped Matrix ComplexConjugate
open BlockBand.Internal.Contracts.Transmission BlockBand.Internal.Contracts.TransmissionAngular
open BlockBand.SourceProcess.Stochastic.Dyson

variable {N r : ℕ}

/-!
### Elementary matrices against the eigenvalue diagonal
-/

theorem single_mul_diagonal' (d : Fin N → ℂ) (a b : Fin N) :
    single a b (1 : ℂ) * diagonal d = d b • single a b 1 := by
  ext c e
  rw [mul_diagonal]
  by_cases h : a = c ∧ b = e
  · obtain ⟨rfl, rfl⟩ := h; simp
  · simp only [Matrix.smul_apply, single_apply, h, ↓reduceIte, zero_mul, smul_zero]

theorem diagonal_mul_single' (d : Fin N → ℂ) (a b : Fin N) :
    diagonal d * single a b (1 : ℂ) = d a • single a b 1 := by
  ext c e
  rw [diagonal_mul]
  by_cases h : a = c ∧ b = e
  · obtain ⟨rfl, rfl⟩ := h; simp
  · simp only [Matrix.smul_apply, single_apply, h, ↓reduceIte, mul_zero, smul_zero]

section Pair
variable (i j : Fin N) (d : Fin N → ℝ)

theorem comm_jX : jX i j * diagonal (fun k => (d k : ℂ)) - diagonal (fun k => (d k : ℂ)) * jX i j =
    (d i - d j) • (single j i 1 + single i j 1) := by
  simp only [jX, sub_mul, mul_sub, single_mul_diagonal', diagonal_mul_single', ← Complex.coe_smul,
    Complex.ofReal_sub]
  module

theorem comm_jY : jY i j * diagonal (fun k => (d k : ℂ)) - diagonal (fun k => (d k : ℂ)) * jY i j =
    (d i - d j) • (Complex.I • (single j i 1 - single i j 1)) := by
  simp only [jY, smul_mul_assoc, mul_smul_comm, add_mul, mul_add, single_mul_diagonal',
    diagonal_mul_single', ← Complex.coe_smul, Complex.ofReal_sub, smul_sub, smul_add, smul_smul]
  module

theorem anti_piM : piM i j * diagonal (fun k => (d k : ℂ)) + diagonal (fun k => (d k : ℂ)) * piM i j =
    (2 * d i) • single i i 1 + (2 * d j) • single j j 1 := by
  simp only [piM, add_mul, mul_add, single_mul_diagonal', diagonal_mul_single', ← Complex.coe_smul,
    Complex.ofReal_mul, Complex.ofReal_ofNat]
  module

variable {i j} (hij : i ≠ j)
include hij

theorem sandwich_jX : jX i j * diagonal (fun k => (d k : ℂ)) * jX i j =
    -(d i • single j j 1 + d j • single i i 1) := by
  simp only [jX, sub_mul, mul_sub, single_mul_diagonal', smul_mul_assoc,
    single_mul_single_same, single_mul_single_of_ne, hij, Ne.symm hij, ne_eq, not_false_eq_true,
    mul_one, smul_zero, ← Complex.coe_smul]
  module

theorem sandwich_jY : jY i j * diagonal (fun k => (d k : ℂ)) * jY i j =
    -(d i • single j j 1 + d j • single i i 1) := by
  simp only [jY, smul_mul_assoc, mul_smul_comm, add_mul, mul_add, single_mul_diagonal',
    single_mul_single_same, single_mul_single_of_ne, hij, Ne.symm hij, ne_eq, not_false_eq_true,
    mul_one, smul_zero, smul_add, smul_smul, ← Complex.coe_smul]
  linear_combination (norm := module) Complex.I_sq •
    (((d j : ℝ) : ℂ) • single i i (1 : ℂ) + ((d i : ℝ) : ℂ) • single j j 1)

end Pair

theorem hermBasis_lt_eq {i j : Fin N} (hij : i < j) :
    hermBasis (i, j) = (Real.sqrt 2)⁻¹ • (single j i (1 : ℂ) + single i j 1) := by
  ext a b
  rw [hermBasis_lt hij]
  simp only [isq2, ind, Matrix.smul_apply, Matrix.add_apply, single_apply, ← Complex.coe_smul,
    smul_eq_mul]
  by_cases h1 : a = i ∧ b = j
  · obtain ⟨rfl, rfl⟩ := h1; simp [hij.ne]
  · by_cases h2 : a = j ∧ b = i
    · obtain ⟨rfl, rfl⟩ := h2; simp [hij.ne]
    · simp only [h1, h2, ↓reduceIte, eq_comm (a := i), eq_comm (a := j)]

theorem hermBasis_gt_eq {i j : Fin N} (hij : i < j) :
    hermBasis (j, i) = (-(Real.sqrt 2)⁻¹) • (Complex.I • (single j i (1 : ℂ) - single i j 1)) := by
  ext a b
  rw [hermBasis_gt hij]
  simp only [isq2, ind, Matrix.smul_apply, Matrix.sub_apply, single_apply, ← Complex.coe_smul,
    smul_eq_mul, Complex.ofReal_neg]
  by_cases h1 : a = i ∧ b = j
  · obtain ⟨rfl, rfl⟩ := h1; simp [hij.ne, mul_comm]
  · by_cases h2 : a = j ∧ b = i
    · obtain ⟨rfl, rfl⟩ := h2; simp [hij.ne, mul_comm]
    · simp only [h1, h2, ↓reduceIte, eq_comm (a := i), eq_comm (a := j)]
      ring

theorem hermBasis_diag_eq (p : Fin N) : hermBasis (p, p) = single p p (1 : ℂ) := by
  ext a b
  rw [hermBasis_diag]
  simp only [ind, single_apply, eq_comm (a := p)]

/-- Splitting a double sum into the diagonal and the pairs `p < q`. -/
theorem sum_sum_split (g : Fin N → Fin N → ℝ) :
    ∑ p, ∑ q, g p q =
      ∑ p, g p p + ∑ p, ∑ q ∈ Finset.univ.filter (fun q => p < q), (g p q + g q p) := by
  have h1 : ∀ p q, g p q = ((if q = p then g p q else 0) + (if p < q then g p q else 0)) +
      (if q < p then g p q else 0) := by
    intro p q
    rcases lt_trichotomy p q with h | rfl | h
    · simp [h, h.ne', not_lt.2 h.le]
    · simp
    · simp [h, h.ne, not_lt.2 h.le]
  have h2 : ∑ p, ∑ q, (if q < p then g p q else 0) = ∑ p, ∑ q, (if p < q then g q p else 0) :=
    Finset.sum_comm
  have h3 : ∀ p, ∑ q ∈ Finset.univ.filter (fun q => p < q), (g p q + g q p) =
      ∑ q, (if p < q then g p q else 0) + ∑ q, (if p < q then g q p else 0) := by
    intro p
    rw [Finset.sum_filter, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun q _ => ?_
    split_ifs <;> simp
  conv_lhs => enter [2, p, 2, q]; rw [h1 p q]
  simp only [Finset.sum_add_distrib, Finset.sum_ite_eq', Finset.mem_univ, ite_true, h3]
  rw [h2]
  ring

/-!
### The adapted second derivatives
-/

variable {V : Matrix (Fin N) (Fin r) ℂ} {f₀ : AngularArray N r → ℝ}

theorem eigDiag_eq (y : Fin (N * N) → ℝ) :
    eigDiag N y = diagonal fun k => (((fun k => lam N k y) k : ℝ) : ℂ) := rfl

/-- `DF[γ''(0)] = 0`: the acceleration of the rotation curve is a combination of projections. -/
theorem fderiv_arrayFn_accel (hf : ContDiff ℝ 2 f₀) (hp : IsPhaseInvariant f₀)
    {y : Fin (N * N) → ℝ} (hy : y ∈ simpleSet N) {i j : Fin N} {J : Matrix (Fin N) (Fin N) ℂ}
    (hJ : J * eigDiag N y * J = -(lam N i y • single j j 1 + lam N j y • single i i 1)) :
    fderiv ℝ (arrayFn V f₀) y (-conjVec (eigMat N y) (piM i j * eigDiag N y + eigDiag N y *
      piM i j) - (2 : ℝ) • conjVec (eigMat N y) (J * eigDiag N y * J)) = 0 := by
  have hs : ∀ m, fderiv ℝ (arrayFn V f₀) y (conjVec (eigMat N y) (single m m 1)) = 0 := by
    intro m
    rw [conjVec_apply, ← proj_eq_eig hy]
    exact fderiv_arrayFn_proj hf hp hy m
  rw [hJ, eigDiag_eq, anti_piM]
  simp only [map_add, map_neg, map_sub, map_smul, hs, smul_zero, add_zero, neg_zero, sub_zero]

/-- **The `X` direction**: `2(λ_i - λ_j)² D²F[w_{ij}, w_{ij}] = X_ij² f₀(Z)`. -/
theorem offdiag_X (hf : ContDiff ℝ 2 f₀) (hp : IsPhaseInvariant f₀) {y : Fin (N * N) → ℝ}
    (hy : y ∈ simpleSet N) {i j : Fin N} (hij : i < j) :
    2 * (lam N i y - lam N j y) ^ 2 * fderiv ℝ (fderiv ℝ (arrayFn V f₀)) y
        (conjVec (eigMat N y) (hermBasis (i, j))) (conjVec (eigMat N y) (hermBasis (i, j))) =
      fderiv ℝ (fderiv ℝ f₀) (arrZ V y) (pairRotX i j (arrZ V y)) (pairRotX i j (arrZ V y)) +
        fderiv ℝ f₀ (arrZ V y) (pairRotX i j (pairRotX i j (arrZ V y))) := by
  have hne := hij.ne
  have key := offdiag_core (V := V) (star_piM i j) (star_jX i j) (piM_mul_self hne)
    (jX_mul_self hne) (piM_mul_jX hne) (jX_mul_piM hne) hf hp hy
  rw [fderiv_arrayFn_accel hf hp hy (sandwich_jX (fun k => lam N k y) hne), add_zero,
    show jX i j * eigDiag N y - eigDiag N y * jX i j = _ from comm_jX i j fun k => lam N k y,
    arrMul_jX hne, arrMul_jX hne] at key
  rw [← key, hermBasis_lt_eq hij]
  simp only [map_smul, _root_.smul_apply, smul_eq_mul]
  have h2 : (Real.sqrt 2)⁻¹ * (Real.sqrt 2)⁻¹ = 1 / 2 := by
    rw [← mul_inv, Real.mul_self_sqrt (by norm_num : (0 : ℝ) ≤ 2)]; norm_num
  linear_combination (2 * (lam N i y - lam N j y) ^ 2 * fderiv ℝ (fderiv ℝ (arrayFn V f₀)) y
    (conjVec (eigMat N y) (single j i 1 + single i j 1))
    (conjVec (eigMat N y) (single j i 1 + single i j 1))) * h2

/-- **The `Y` direction**: `2(λ_i - λ_j)² D²F[w_{ji}, w_{ji}] = Y_ij² f₀(Z)`. -/
theorem offdiag_Y (hf : ContDiff ℝ 2 f₀) (hp : IsPhaseInvariant f₀) {y : Fin (N * N) → ℝ}
    (hy : y ∈ simpleSet N) {i j : Fin N} (hij : i < j) :
    2 * (lam N i y - lam N j y) ^ 2 * fderiv ℝ (fderiv ℝ (arrayFn V f₀)) y
        (conjVec (eigMat N y) (hermBasis (j, i))) (conjVec (eigMat N y) (hermBasis (j, i))) =
      fderiv ℝ (fderiv ℝ f₀) (arrZ V y) (pairRotY i j (arrZ V y)) (pairRotY i j (arrZ V y)) +
        fderiv ℝ f₀ (arrZ V y) (pairRotY i j (pairRotY i j (arrZ V y))) := by
  have hne := hij.ne
  have key := offdiag_core (V := V) (star_piM i j) (star_jY i j) (piM_mul_self hne)
    (jY_mul_self hne) (piM_mul_jY hne) (jY_mul_piM hne) hf hp hy
  rw [fderiv_arrayFn_accel hf hp hy (sandwich_jY (fun k => lam N k y) hne), add_zero,
    show jY i j * eigDiag N y - eigDiag N y * jY i j = _ from comm_jY i j fun k => lam N k y,
    arrMul_jY hne, arrMul_jY hne] at key
  rw [← key, hermBasis_gt_eq hij]
  simp only [map_smul, _root_.smul_apply, smul_eq_mul]
  have h2 : (Real.sqrt 2)⁻¹ * (Real.sqrt 2)⁻¹ = 1 / 2 := by
    rw [← mul_inv, Real.mul_self_sqrt (by norm_num : (0 : ℝ) ≤ 2)]; norm_num
  linear_combination (2 * (lam N i y - lam N j y) ^ 2 * fderiv ℝ (fderiv ℝ (arrayFn V f₀)) y
    (conjVec (eigMat N y) (Complex.I • (single j i 1 - single i j 1)))
    (conjVec (eigMat N y) (Complex.I • (single j i 1 - single i j 1)))) * h2

/-!
### The Laplacian identity
-/

/-- **`ArrayLaplacianDiag`** (the Laplacian half of `ArrayLaplacian`): on simple
spectrum, `∑_a ∂_a² arrayFn V f₀ = 2N · arrGen V f₀`. -/
theorem arrayLaplacianDiag (N r : ℕ) : ArrayLaplacianDiag N r := by
  intro V f₀ hf hp y hy
  set B := fderiv ℝ (fderiv ℝ (arrayFn V f₀)) y
  set U := eigMat N y
  set g : Fin N → Fin N → ℝ := fun p q => B (conjVec U (hermBasis (p, q)))
    (conjVec U (hermBasis (p, q))) with hg
  rw [trace_bilin_eq_of_complete B _ (complete_conjVec (eigMat_star_mul y)),
    show (∑ a, B (conjVec U (hermBasis (finProdFinEquiv.symm a)))
        (conjVec U (hermBasis (finProdFinEquiv.symm a)))) = ∑ x : Fin N × Fin N, g x.1 x.2 from
      Fintype.sum_equiv finProdFinEquiv.symm _ _ (fun _ => rfl),
    Fintype.sum_prod_type, sum_sum_split]
  have hdiag : ∀ p, g p p = 0 := fun p => by
    simp only [hg]
    rw [hermBasis_diag_eq, conjVec_apply, ← proj_eq_eig hy]
    exact fderiv2_arrayFn_proj hf hp hy p
  simp only [hdiag, Finset.sum_const_zero, zero_add]
  rw [arrGen_of_mem hy, complexAngularGenerator, ← mul_assoc, Finset.mul_sum]
  refine Finset.sum_congr rfl fun p _ => ?_
  rw [Finset.mul_sum]
  refine Finset.sum_congr rfl fun q hq => ?_
  have hpq : p < q := (Finset.mem_filter.mp hq).2
  have hX : 2 * (lam N p y - lam N q y) ^ 2 * g p q = _ := offdiag_X (V := V) hf hp hy hpq
  have hY : 2 * (lam N p y - lam N q y) ^ 2 * g q p = _ := offdiag_Y (V := V) hf hp hy hpq
  have hgap : lam N p y - lam N q y ≠ 0 := sub_ne_zero.mpr (HasSimpleSpectrum.ne hy hpq.ne)
  have hN : (N : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr (Fin.pos p).ne'
  simp only [dysonCoupling]
  rw [add_assoc (_ + _), ← hX, ← hY]
  field_simp
  ring

end BlockBand.SourceProcess.Stochastic.ComplexAngular
