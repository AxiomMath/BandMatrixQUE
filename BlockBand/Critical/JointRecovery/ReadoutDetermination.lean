module

public import BlockBand.Critical.JointRecovery.ReadoutTest
public import BlockBand.LawSpace.MarkedLaplaceDetermination

/-!
# Readout Laplace functionals determine marked laws

`markedLaw_eq_of_readoutLaplace`: two laws on `MarkedPointMeasure` with the same readout Laplace
functionals, for every finite nonnegative profile family and every nonnegative test, are equal.
Proof: on each compact slab `[-L, L] × P(𝕋)` the algebra generated by the spectral coordinate and
the mark integrals separates points (Stone–Weierstrass), so every nonnegative compactly supported
test is approximated by readout tests (`exists_readout_approx`), and the marked Laplace
determination `LawSpace.markedPointMeasureLaw_eq_of_laplace` concludes.

Law space: probability laws on `MarkedPointMeasure` (marked vague topology on `ℝ × P(𝕋)`, weak
topology on `P(𝕋)`, Borel σ-algebra). No hypothesis is used.
-/

set_option autoImplicit false

@[expose] public section

noncomputable section

namespace BlockBand.Critical.JointRecovery

open Filter Topology Set MeasureTheory
open BlockBand.Internal.Contracts.CriticalEntire
open scoped BoundedContinuousFunction

/-- The compact slab `[-L, L] × P(𝕋)`. -/
def slab (L : ℝ) : Set MarkedSpectralSpace := Icc (-L) L ×ˢ univ

theorem isCompact_slab (L : ℝ) : IsCompact (slab L) := isCompact_Icc.prod isCompact_univ

instance compactSpace_slab (L : ℝ) : CompactSpace (slab L) :=
  isCompact_iff_compactSpace.mp (isCompact_slab L)

/-- Spectral coordinate on the slab. -/
def slabU (L : ℝ) : C(slab L, ℝ) := ⟨fun x => x.1.1, continuous_fst.comp continuous_subtype_val⟩

/-- Mark integral `ν(φ)` on the slab. -/
def slabQ (L : ℝ) (φ : C(Torus, ℝ)) : C(slab L, ℝ) :=
  ⟨fun x => ∫ r, φ r ∂(x.1.2 : Measure Torus),
    (continuous_integral_massProfile φ).comp (continuous_snd.comp continuous_subtype_val)⟩

/-- The algebra generated by the spectral coordinate and the mark integrals. -/
def slabAlgebra (L : ℝ) : Subalgebra ℝ C(slab L, ℝ) :=
  Algebra.adjoin ℝ (insert (slabU L) (range (slabQ L)))

/-- Probability measures on the circle are determined by continuous integrals. -/
theorem massProfile_ext {ν ν' : MassProfile}
    (h : ∀ φ : C(Torus, ℝ), ∫ r, φ r ∂(ν : Measure Torus) = ∫ r, φ r ∂(ν' : Measure Torus)) :
    ν = ν' := by
  apply (ProbabilityMeasure.toFiniteMeasure_isEmbedding Torus).injective
  apply FiniteMeasure.ext_of_forall_integral_eq
  intro f
  exact h f.toContinuousMap

/-- The slab algebra separates points: the spectral coordinate separates distinct
locations, and continuous mark integrals separate distinct probability measures on `𝕋`. -/
theorem slabAlgebra_separatesPoints (L : ℝ) : (slabAlgebra L).SeparatesPoints := by
  intro x y hxy
  by_cases hu : x.1.1 = y.1.1
  · have hν : x.1.2 ≠ y.1.2 := fun h => hxy (Subtype.ext (Prod.ext hu h))
    have : ∃ φ : C(Torus, ℝ), ∫ r, φ r ∂(x.1.2 : Measure Torus) ≠
        ∫ r, φ r ∂(y.1.2 : Measure Torus) := by
      by_contra hcon
      push Not at hcon
      exact hν (massProfile_ext hcon)
    obtain ⟨φ, hφ⟩ := this
    exact ⟨_, ⟨slabQ L φ, Algebra.subset_adjoin (mem_insert_of_mem _ ⟨φ, rfl⟩), rfl⟩, hφ⟩
  · exact ⟨_, ⟨slabU L, Algebra.subset_adjoin (mem_insert _ _), rfl⟩, hu⟩

/-- A function on the slab factors through finitely many mark integrals. -/
def IsReadoutRep {L : ℝ} (h : C(slab L, ℝ)) : Prop :=
  ∃ (k : ℕ) (q : Fin k → C(Torus, ℝ)) (Φ : ℝ × (Fin k → ℝ) → ℝ), Continuous Φ ∧
    ∀ x : slab L, h x = Φ (x.1.1, fun a => ∫ r, q a r ∂(x.1.2 : Measure Torus))

theorem continuous_split_left {k₁ k₂ : ℕ} :
    Continuous fun p : ℝ × (Fin (k₁ + k₂) → ℝ) => (p.1, fun a : Fin k₁ => p.2 (Fin.castAdd k₂ a)) :=
  continuous_fst.prodMk (continuous_pi fun _ => (continuous_apply _).comp continuous_snd)

theorem continuous_split_right {k₁ k₂ : ℕ} :
    Continuous fun p : ℝ × (Fin (k₁ + k₂) → ℝ) => (p.1, fun a : Fin k₂ => p.2 (Fin.natAdd k₁ a)) :=
  continuous_fst.prodMk (continuous_pi fun _ => (continuous_apply _).comp continuous_snd)

/-- Every element of the slab algebra factors continuously through finitely many mark
integrals (closure of the factorization under `+`, `*` and constants, via `Fin.append`). -/
theorem isReadoutRep_of_mem {L : ℝ} {h : C(slab L, ℝ)} (hh : h ∈ slabAlgebra L) :
    IsReadoutRep h := by
  induction hh using Algebra.adjoin_induction with
  | mem x hx =>
    rcases hx with rfl | ⟨φ, rfl⟩
    · exact ⟨0, Fin.elim0, fun p => p.1, continuous_fst, fun x => rfl⟩
    · exact ⟨1, ![φ], fun p => p.2 0, (continuous_apply 0).comp continuous_snd, fun x => rfl⟩
  | algebraMap r => exact ⟨0, Fin.elim0, fun _ => r, continuous_const, fun x => rfl⟩
  | add x y _ _ hx hy =>
    obtain ⟨k₁, q₁, Φ₁, hΦ₁, h₁⟩ := hx
    obtain ⟨k₂, q₂, Φ₂, hΦ₂, h₂⟩ := hy
    refine ⟨k₁ + k₂, Fin.append q₁ q₂,
      fun p => Φ₁ (p.1, fun a => p.2 (Fin.castAdd k₂ a)) + Φ₂ (p.1, fun a => p.2 (Fin.natAdd k₁ a)),
      (hΦ₁.comp continuous_split_left).add (hΦ₂.comp continuous_split_right), fun z => ?_⟩
    simp only [ContinuousMap.add_apply, h₁, h₂, Fin.append_left, Fin.append_right]
  | mul x y _ _ hx hy =>
    obtain ⟨k₁, q₁, Φ₁, hΦ₁, h₁⟩ := hx
    obtain ⟨k₂, q₂, Φ₂, hΦ₂, h₂⟩ := hy
    refine ⟨k₁ + k₂, Fin.append q₁ q₂,
      fun p => Φ₁ (p.1, fun a => p.2 (Fin.castAdd k₂ a)) * Φ₂ (p.1, fun a => p.2 (Fin.natAdd k₁ a)),
      (hΦ₁.comp continuous_split_left).mul (hΦ₂.comp continuous_split_right), fun z => ?_⟩
    simp only [ContinuousMap.mul_apply, h₁, h₂, Fin.append_left, Fin.append_right]

/-- The piecewise-linear cutoff `max 0 (min 1 (L - |u|))`. -/
def cutoff (L u : ℝ) : ℝ := max 0 (min 1 (L - |u|))

theorem continuous_cutoff (L : ℝ) : Continuous (cutoff L) := by unfold cutoff; fun_prop

theorem cutoff_nonneg (L u : ℝ) : 0 ≤ cutoff L u := le_max_left _ _

theorem cutoff_le_one (L u : ℝ) : cutoff L u ≤ 1 :=
  max_le zero_le_one (min_le_left _ _)

theorem cutoff_eq_one {L u : ℝ} (h : |u| ≤ L - 1) : cutoff L u = 1 := by
  unfold cutoff; rw [min_eq_left (by linarith), max_eq_right zero_le_one]

theorem cutoff_eq_zero {L u : ℝ} (h : L ≤ |u|) : cutoff L u = 0 := by
  unfold cutoff; rw [max_eq_left (min_le_of_right_le (by linarith))]

theorem abs_integral_le_norm (φ : C(Torus, ℝ)) (ν : MassProfile) :
    |∫ r, φ r ∂(ν : Measure Torus)| ≤ ‖φ‖ := by
  have h := norm_integral_le_of_norm_le_const (μ := (ν : Measure Torus)) (f := fun r => φ r)
    (C := ‖φ‖) (.of_forall fun r => φ.norm_coe_le_norm r)
  simpa [Real.norm_eq_abs] using h

/-- **Approximation by readout tests.** A nonnegative `g ∈ C_c(ℝ × P(𝕋))` vanishing for
`|u| > A` is uniformly approximated, within `ε` on the slab `[-A-1, A+1] × P(𝕋)` and exactly
outside it, by `readoutTest q f` with `q` a nonnegative family and `f ≥ 0`. -/
theorem exists_readout_approx (g : CompactlySupportedContinuousMap MarkedSpectralSpace ℝ)
    (hg : ∀ z, 0 ≤ g z) {A : ℝ} (hA : ∀ z, g z ≠ 0 → |z.1| ≤ A) {ε : ℝ}
    (hε : 0 < ε) :
    ∃ (k : ℕ) (q : Fin k → C(Torus, ℝ)) (f : CompactlySupportedContinuousMap
      (ℝ × (Fin (k + 1) → ℂ)) ℝ), IsProfileFamily q ∧ (∀ z, 0 ≤ f z) ∧
      ∀ z, |g z - readoutTest q f z| ≤ ε * (slab (A + 1)).indicator 1 z := by
  set L := A + 1 with hL
  obtain ⟨h, hh⟩ := ContinuousMap.exists_mem_subalgebra_near_continuous_of_separatesPoints
    (slabAlgebra L) (slabAlgebra_separatesPoints L) (fun x : slab L => g x.1)
    (g.continuous.comp continuous_subtype_val) ε hε
  obtain ⟨k, q, Φ, hΦ, hrep⟩ := isReadoutRep_of_mem h.2
  -- nonnegative shifts
  let qp : Fin k → C(Torus, ℝ) := fun a => q a + ContinuousMap.const Torus ‖q a‖
  have hqp : IsProfileFamily qp := by
    intro a x
    have := (abs_le.mp ((q a).norm_coe_le_norm x)).1
    simp only [qp, ContinuousMap.add_apply, ContinuousMap.const_apply]
    linarith
  have hint : ∀ (a : Fin k) (ν : MassProfile), ∫ r, qp a r ∂(ν : Measure Torus) =
      ∫ r, q a r ∂(ν : Measure Torus) + ‖q a‖ := by
    intro a ν
    simp only [qp, ContinuousMap.add_apply, ContinuousMap.const_apply]
    rw [integral_add ((q a).continuous.integrable_of_hasCompactSupport
      (HasCompactSupport.of_compactSpace _)) (integrable_const _), integral_const]
    simp
  set M : ℝ := 1 + ∑ a, 2 * ‖q a‖ with hM
  have hM1 : 1 ≤ M := by
    have : 0 ≤ ∑ a, 2 * ‖q a‖ := Finset.sum_nonneg fun a _ => by positivity
    linarith
  let Ψ : ℝ × (Fin (k + 1) → ℂ) → ℝ := fun p => Φ (p.1, fun a => (p.2 a.succ).re - ‖q a‖)
  have hΨ : Continuous Ψ := hΦ.comp (continuous_fst.prodMk (continuous_pi fun a =>
    ((Complex.continuous_re.comp ((continuous_apply _).comp continuous_snd)).sub continuous_const)))
  let F : ℝ × (Fin (k + 1) → ℂ) → ℝ := fun p =>
    cutoff L p.1 * max 0 (Ψ p) * max 0 (min 1 (M + 1 - ‖p.2‖))
  have hFc : Continuous F :=
    (((continuous_cutoff L).comp continuous_fst).mul (continuous_const.max hΨ)).mul
      (continuous_const.max (continuous_const.min (continuous_const.sub continuous_snd.norm)))
  let f : CompactlySupportedContinuousMap (ℝ × (Fin (k + 1) → ℂ)) ℝ :=
    { toFun := F
      continuous_toFun := hFc
      hasCompactSupport' := by
        refine HasCompactSupport.intro' (K := Icc (-L) L ×ˢ Metric.closedBall 0 (M + 1))
          (isCompact_Icc.prod (isCompact_closedBall _ _))
          (isClosed_Icc.prod Metric.isClosed_closedBall) ?_
        intro p hp
        simp only [F]
        rw [mem_prod, not_and_or] at hp
        rcases hp with hp | hp
        · rw [cutoff_eq_zero (by
            by_contra hlt; push Not at hlt; exact hp (abs_le.mp hlt.le)), zero_mul, zero_mul]
        · rw [Metric.mem_closedBall, dist_zero_right, not_le] at hp
          rw [max_eq_left (min_le_of_right_le (by linarith)), mul_zero] }
  have hf0 : ∀ p, 0 ≤ f p := fun p => by
    show 0 ≤ F p
    exact mul_nonneg (mul_nonneg (cutoff_nonneg _ _) (le_max_left _ _)) (le_max_left _ _)
  refine ⟨k, qp, f, hqp, hf0, fun z => ?_⟩
  -- evaluate the readout
  have hnorm : ‖(profileReadout qp z).2‖ ≤ M := by
    refine (pi_norm_le_iff_of_nonneg (by linarith)).mpr fun a => ?_
    simp only [profileReadout]
    rw [Complex.norm_real, Real.norm_eq_abs]
    refine Fin.cases ?_ (fun i => ?_) a
    · simp only [fullProfile, Fin.cons_zero, ContinuousMap.const_apply, integral_const,
        probReal_univ, smul_eq_mul, mul_one, abs_one]
      exact hM1
    · simp only [fullProfile, Fin.cons_succ]
      refine (abs_integral_le_norm (qp i) z.2).trans ?_
      have h1 : ‖qp i‖ ≤ 2 * ‖q i‖ := by
        refine (norm_add_le _ _).trans ?_
        have : ‖ContinuousMap.const Torus ‖q i‖‖ ≤ ‖q i‖ :=
          (ContinuousMap.norm_le _ (norm_nonneg _)).mpr fun x => by simp
        linarith
      have h2 : 2 * ‖q i‖ ≤ ∑ a, 2 * ‖q a‖ :=
        Finset.single_le_sum (f := fun a => 2 * ‖q a‖) (fun a _ => by positivity)
          (Finset.mem_univ i)
      linarith
  have hread : readoutTest qp f z = cutoff L z.1 *
      max 0 (Φ (z.1, fun a => ∫ r, q a r ∂(z.2 : Measure Torus))) := by
    show F (profileReadout qp z) = _
    simp only [F]
    rw [min_eq_left (by linarith [hnorm]), max_eq_right zero_le_one, mul_one]
    simp only [Ψ, profileReadout, fullProfile, Fin.cons_succ, Complex.ofReal_re, hint,
      add_sub_cancel_right]
  rw [hread]
  by_cases hz : z ∈ slab L
  · rw [indicator_of_mem hz, Pi.one_apply, mul_one]
    have hhz := hh ⟨z, hz⟩
    rw [hrep ⟨z, hz⟩] at hhz
    simp only [Real.norm_eq_abs] at hhz
    set φv := Φ (z.1, fun a => ∫ r, q a r ∂(z.2 : Measure Torus))
    by_cases hzA : |z.1| ≤ A
    · rw [cutoff_eq_one (by linarith), one_mul]
      rcases le_total 0 φv with hφ | hφ
      · rw [max_eq_right hφ, abs_sub_comm]; exact hhz.le
      · rw [max_eq_left hφ, sub_zero, abs_of_nonneg (hg z)]
        have := abs_le.mp hhz.le
        linarith
    · have hgz : g z = 0 := by
        by_contra hne; exact hzA (hA z hne)
      rw [hgz, zero_sub, abs_neg, abs_of_nonneg (mul_nonneg (cutoff_nonneg _ _) (le_max_left _ _))]
      rw [hgz, sub_zero] at hhz
      calc cutoff L z.1 * max 0 φv ≤ 1 * max 0 φv :=
            mul_le_mul_of_nonneg_right (cutoff_le_one _ _) (le_max_left _ _)
        _ ≤ ε := by
            rw [one_mul]
            exact max_le hε.le ((le_abs_self _).trans hhz.le)
  · rw [indicator_of_notMem hz, mul_zero]
    have hzL : L < |z.1| := by
      by_contra hle; push Not at hle; exact hz ⟨abs_le.mp hle, mem_univ _⟩
    have hgz : g z = 0 := by
      by_contra hne; have := hA z hne; linarith
    rw [hgz, cutoff_eq_zero hzL.le, zero_mul, sub_zero, abs_zero]

/-- Pointwise convergence of the marked integrals of the approximants. -/
theorem tendsto_markedIntegral_of_approx (g : CompactlySupportedContinuousMap MarkedSpectralSpace ℝ)
    {L : ℝ} (r : ℕ → CompactlySupportedContinuousMap MarkedSpectralSpace ℝ)
    (hr : ∀ n z, |g z - r n z| ≤ (1 / ((n : ℝ) + 1)) * (slab L).indicator 1 z)
    (ξ : MarkedPointMeasure) :
    Tendsto (fun n => ∫ z, r n z ∂ξ.marked.measure) atTop (𝓝 (∫ z, g z ∂ξ.marked.measure)) := by
  have := BlockBand.Model.Construction.markedSpectralSpace_borelSpace
  have hslab : MeasurableSet (slab L) := (isCompact_slab L).isClosed.measurableSet
  have hfin : ξ.marked.measure (slab L) < ⊤ := ξ.marked.finite_on_compact _ (isCompact_slab L)
  have hint : ∀ h : CompactlySupportedContinuousMap MarkedSpectralSpace ℝ,
      Integrable (fun z => h z) ξ.marked.measure := fun h =>
    h.continuous.integrable_of_hasCompactSupport h.hasCompactSupport
  rw [Metric.tendsto_atTop]
  intro ε hε
  set c := ξ.marked.measure.real (slab L) with hc
  obtain ⟨N, hN⟩ := exists_nat_gt (c / ε)
  refine ⟨N, fun n hn => ?_⟩
  rw [Real.dist_eq, ← integral_sub (hint _) (hint _)]
  have hbound : ‖∫ z, (r n z - g z) ∂ξ.marked.measure‖ ≤
      ∫ z, (1 / ((n : ℝ) + 1)) * (slab L).indicator 1 z ∂ξ.marked.measure := by
    refine norm_integral_le_of_norm_le ((integrable_indicator_iff hslab).mpr
      (integrableOn_const (by exact hfin.ne)) |>.const_mul _) (.of_forall fun z => ?_)
    rw [Real.norm_eq_abs, abs_sub_comm]; exact hr n z
  rw [integral_const_mul, integral_indicator_one hslab, ← hc] at hbound
  rw [← Real.norm_eq_abs]
  refine lt_of_le_of_lt hbound ?_
  have hc0 : 0 ≤ c := measureReal_nonneg
  have hnN : (N : ℝ) ≤ n := by exact_mod_cast hn
  have hn1 : (N : ℝ) < n + 1 := by linarith
  rw [div_lt_iff₀ hε] at hN
  calc 1 / ((n : ℝ) + 1) * c = c / ((n : ℝ) + 1) := by ring
    _ < ε := by rw [div_lt_iff₀ (by positivity)]; nlinarith

/-- **Readout determination of marked laws.** -/
theorem markedLaw_eq_of_readoutLaplace (ν₁ ν₂ : ProbabilityMeasure MarkedPointMeasure)
    (h : ∀ (k : ℕ) (q : Fin k → C(Torus, ℝ)), IsProfileFamily q →
      ∀ f : CompactlySupportedContinuousMap (ℝ × (Fin (k + 1) → ℂ)) ℝ, (∀ z, 0 ≤ f z) →
        readoutLaplace q ν₁ f = readoutLaplace q ν₂ f) : ν₁ = ν₂ := by
  apply BlockBand.LawSpace.markedPointMeasureLaw_eq_of_laplace
  intro g hg
  obtain ⟨A, -, hA⟩ := exists_abs_fst_bound g
  choose k q f hq hf hbound using fun n : ℕ =>
    exists_readout_approx g hg hA (ε := 1 / ((n : ℝ) + 1)) Nat.one_div_pos_of_nat
  have hlim : ∀ ν : ProbabilityMeasure MarkedPointMeasure,
      Tendsto (fun n => readoutLaplace (q n) ν (f n)) atTop
        (𝓝 (∫ ξ, Real.exp (-∫ z, g z ∂ξ.marked.measure) ∂(ν : Measure MarkedPointMeasure))) := by
    intro ν
    simp_rw [readoutLaplace_eq_integral _ _ _ (hf _)]
    refine tendsto_integral_of_dominated_convergence (fun _ => (1 : ℝ)) (fun n =>
      (markedLaplaceBCF _ _).continuous.aestronglyMeasurable) (integrable_const _)
      (fun n => .of_forall fun ξ => ?_) (.of_forall fun ξ => ?_)
    · rw [markedLaplaceBCF_apply, Real.norm_eq_abs, abs_of_pos (Real.exp_pos _),
        Real.exp_le_one_iff, neg_nonpos]
      exact integral_nonneg fun z => hf n _
    · simp only [markedLaplaceBCF_apply]
      exact (Real.continuous_exp.tendsto _).comp
        (tendsto_markedIntegral_of_approx g (fun n => readoutTest (q n) (f n)) hbound ξ).neg
  exact tendsto_nhds_unique ((hlim ν₁).congr fun n => h _ _ (hq n) _ (hf n)) (hlim ν₂)

end BlockBand.Critical.JointRecovery
