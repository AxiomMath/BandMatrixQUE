module

public import BlockBand.Model.Construction.MarkedStateTopologyConsequences
public import BlockBand.Endpoints.FinitePointMeasure

/-!
# Measurability in the vague state space

The Borel σ-algebra of `VaguePointMeasure X` is generated by countably many nonnegative vague
coordinates. Hence a map into `VaguePointMeasure X` is measurable as soon as all its nonnegative
coordinates are, and finite configuration maps `x ↦ ∑ i, δ_{x i}` are measurable.
-/

set_option autoImplicit false

@[expose] public section

noncomputable section

namespace BlockBand.Endpoints

open MeasureTheory Set TopologicalSpace
open BlockBand.Model.Construction

variable {X : Type*} [TopologicalSpace X] [MeasurableSpace X] [BorelSpace X]
  [T2Space X] [SecondCountableTopology X] [LocallyCompactSpace X]

/-- Countable index set of the nonnegative test family: a countable signed test
index together with a sign selector (`true` positive part, `false` negative part). -/
abbrev VagueNonnegIndex : Type := (ℕ × Option ℕ) × Bool

variable (X) in
/-- The nonnegative test family: positive (`true`) and negative (`false`) parts
`g ⊔ 0`, `(-g) ⊔ 0` of the countable signed tests `g = stateCountableTest X nm`. -/
def vagueNonnegTest (j : VagueNonnegIndex) : CompactlySupportedContinuousMap X ℝ :=
  cond j.2 (stateCountableTest X j.1 ⊔ 0) ((-stateCountableTest X j.1) ⊔ 0)

omit [MeasurableSpace X] [BorelSpace X] in
/-- Every member of the nonnegative test family is pointwise nonnegative on `X`. -/
theorem vagueNonnegTest_nonneg (j : VagueNonnegIndex) (x : X) :
    0 ≤ vagueNonnegTest X j x := by
  rcases j with ⟨nm, _ | _⟩ <;> simp [vagueNonnegTest]

omit [MeasurableSpace X] [BorelSpace X] in
/-- Pointwise on `X`, each countable signed test is the difference of its
positive and negative parts. -/
theorem stateCountableTest_eq_sub (nm : ℕ × Option ℕ) (x : X) :
    stateCountableTest X nm x =
      vagueNonnegTest X (nm, true) x - vagueNonnegTest X (nm, false) x := by
  simp only [vagueNonnegTest, Bool.cond_true, Bool.cond_false,
    CompactlySupportedContinuousMap.sup_apply, CompactlySupportedContinuousMap.coe_neg,
    Pi.neg_apply, CompactlySupportedContinuousMap.coe_zero, Pi.zero_apply]
  exact (max_zero_sub_max_neg_zero_eq_self _).symm

variable (X) in
/-- The countable family of nonnegative vague coordinates of a point measure. -/
def vagueNonnegCoordinate (ξ : VaguePointMeasure X) (j : VagueNonnegIndex) : ℝ :=
  ξ.coordinate (vagueNonnegTest X j)

omit [BorelSpace X] [T2Space X] [SecondCountableTopology X] [LocallyCompactSpace X] in
/-- For every locally finite point measure `ξ` on `X` and every pointwise
nonnegative compactly supported continuous test `g`, `0 ≤ ξ(g)`. -/
theorem coordinate_nonneg (ξ : VaguePointMeasure X)
    {g : CompactlySupportedContinuousMap X ℝ} (hg : ∀ x, 0 ≤ g x) :
    0 ≤ ξ.coordinate g :=
  integral_nonneg hg

omit [T2Space X] [SecondCountableTopology X] [LocallyCompactSpace X] in
/-- The coordinate `ξ ↦ ξ(g)` is linear in the test: for every point measure
`ξ` and tests `f, g` in `C_c(X, ℝ)`, `ξ(f + g) = ξ(f) + ξ(g)`. -/
theorem coordinate_add (ξ : VaguePointMeasure X) (f g : CompactlySupportedContinuousMap X ℝ) :
    ξ.coordinate (f + g) = ξ.coordinate f + ξ.coordinate g := by
  have hi (h : CompactlySupportedContinuousMap X ℝ) : Integrable h ξ.measure :=
    h.continuous.integrable_of_hasCompactSupport h.hasCompactSupport
  exact integral_add (hi f) (hi g)

/-- For every point measure `ξ`, each countable signed coordinate is the
difference of two nonnegative coordinates. -/
theorem stateCountableCoordinate_eq_sub (ξ : VaguePointMeasure X) (nm : ℕ × Option ℕ) :
    stateCountableCoordinate X ξ nm =
      vagueNonnegCoordinate X ξ (nm, true) - vagueNonnegCoordinate X ξ (nm, false) := by
  have hi (h : CompactlySupportedContinuousMap X ℝ) : Integrable h ξ.measure :=
    h.continuous.integrable_of_hasCompactSupport h.hasCompactSupport
  simp only [stateCountableCoordinate, vagueNonnegCoordinate, VaguePointMeasure.coordinate]
  rw [← integral_sub (hi _) (hi _)]
  exact integral_congr_ae (ae_of_all _ fun x => stateCountableTest_eq_sub nm x)

omit [BorelSpace X] [T2Space X] [SecondCountableTopology X] [LocallyCompactSpace X] in
/-- Every vague coordinate `ξ ↦ ξ(g)`, `g ∈ C_c(X, ℝ)`, is Borel measurable on
the vague state space. -/
theorem measurable_coordinate (g : CompactlySupportedContinuousMap X ℝ) :
    Measurable (fun ξ : VaguePointMeasure X => ξ.coordinate g) :=
  (continuous_vaguePointMeasure_coordinate g).measurable

omit [BorelSpace X] in
/-- The nonnegative coordinate map `VaguePointMeasure X → (VagueNonnegIndex → ℝ)`
is measurable for the product σ-algebra. -/
theorem measurable_vagueNonnegCoordinate : Measurable (vagueNonnegCoordinate X) :=
  Measurable.of_eval fun j => measurable_coordinate (vagueNonnegTest X j)

/-- Generating σ-algebra: the Borel σ-algebra of `VaguePointMeasure X`
equals the pullback of the product σ-algebra on `VagueNonnegIndex → ℝ` under the
countable family of nonnegative coordinates `vagueNonnegCoordinate X`. -/
theorem vaguePointMeasure_measurableSpace_eq_comap :
    borel (VaguePointMeasure X) =
      MeasurableSpace.comap (vagueNonnegCoordinate X) MeasurableSpace.pi := by
  apply le_antisymm
  · have htop := (vaguePointMeasure_countable_isInducing X).eq_induced
    have hb : borel (VaguePointMeasure X) =
        MeasurableSpace.comap (stateCountableCoordinate X) MeasurableSpace.pi := by
      rw [htop, borel_comap, ← (BorelSpace.measurable_eq :
        (MeasurableSpace.pi : MeasurableSpace ((ℕ × Option ℕ) → ℝ)) = borel _)]
    have hD : Measurable (fun y : VagueNonnegIndex → ℝ =>
        fun nm : ℕ × Option ℕ => y (nm, true) - y (nm, false)) :=
      Measurable.of_eval fun nm => (measurable_pi_apply _).sub (measurable_pi_apply _)
    have hfac : stateCountableCoordinate X =
        (fun y : VagueNonnegIndex → ℝ =>
          fun nm : ℕ × Option ℕ => y (nm, true) - y (nm, false)) ∘
          vagueNonnegCoordinate X := by
      funext ξ nm
      exact stateCountableCoordinate_eq_sub ξ nm
    rw [hb, hfac, ← MeasurableSpace.comap_comp]
    exact MeasurableSpace.comap_mono hD.comap_le
  · exact measurable_vagueNonnegCoordinate.comap_le

/-- A map `F : Ω → VaguePointMeasure X` from any measurable space is measurable as
soon as `ω ↦ (F ω)(g)` is measurable for every pointwise nonnegative test
`g ∈ C_c(X, ℝ)`. -/
theorem measurable_to_vaguePointMeasure {Ω : Type*} [MeasurableSpace Ω]
    {F : Ω → VaguePointMeasure X}
    (h : ∀ g : CompactlySupportedContinuousMap X ℝ, (∀ x, 0 ≤ g x) →
      Measurable fun ω => (F ω).coordinate g) :
    Measurable F := by
  rw [measurable_iff_comap_le]
  change MeasurableSpace.comap F (borel (VaguePointMeasure X)) ≤ _
  rw [vaguePointMeasure_measurableSpace_eq_comap, MeasurableSpace.comap_comp]
  exact (Measurable.of_eval fun j =>
    h (vagueNonnegTest X j) (vagueNonnegTest_nonneg j)).comap_le

/-- For every finite index type `ι`, the finite configuration map
`x ↦ ∑ i, δ_{x i}` from `ι → X` (product σ-algebra) to the vague state
space is measurable. -/
theorem measurable_finitePointMeasure {ι : Type*} [Fintype ι] :
    Measurable (fun x : ι → X => finitePointMeasure x) := by
  apply measurable_to_vaguePointMeasure
  intro g _
  simp only [coordinate_finitePointMeasure]
  exact Finset.measurable_sum _ fun i _ =>
    g.continuous.measurable.comp (measurable_pi_apply i)

end BlockBand.Endpoints
