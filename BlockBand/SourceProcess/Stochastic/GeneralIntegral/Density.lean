module
public import BlockBand.SourceProcess.Stochastic.GeneralIntegral.Setting
public import BlockBand.SourceProcess.FiniteDriverIntegration.ContinuousItoAdaptedRectangleDensity
set_option autoImplicit false
@[expose] public section
noncomputable section

/-!
# Density of predictable rectangles for an arbitrary finite measure

Measure: an arbitrary finite measure `μ` on `ℝ × Ω` (product σ-algebra) concentrated on
times in `(0,T]`; this covers the bracket measure `ν_T = α ds ⊗ Q` of `Setting`, while the
native `ContinuousItoPredictableLambdaSystemClosure` covers only `dt ⊗ P`. Filtration: an
arbitrary raw `𝓖 : Filtration ℝ≥0 m₀`, predictable σ-algebra `predictableSpace (toCF 𝓖)`
(generated by `{0} × A`, `A ∈ 𝓖_0`, and `(s,t] × A`, `A ∈ 𝓖_s`).

`PredL2 𝓖 μ` is the closed subspace of `L²(μ)` of classes with a predictable representative.
`rectSpan_dense`: the real span of the classes `rectL2 r = 1_{(s,t] × A}` of the rectangles
`r : Rect 𝓖 T` is dense in `PredL2 𝓖 μ`. Proof: Dynkin's π-λ theorem on the predictable
generators (the π-system property is the native, measure-free
`predictableGenerators_isPiSystem`), then predictable simple-function density
(`Lp.induction_stronglyMeasurable`).
-/

namespace BlockBand.SourceProcess.Stochastic.GeneralIntegral
open MeasureTheory ProbabilityTheory Filter Topology Set
open scoped NNReal ENNReal
open BlockBand.SourceProcess.FiniteDriverIntegration.ContinuousIto
open BlockBand.SourceProcess.FiniteDriverIntegration.ContinuousItoAdaptedRectangleDensity

variable {Ω : Type*} [mΩ : MeasurableSpace Ω]

/-- Predictable `L²(μ)` classes. -/
abbrev PredL2 (𝓖 : Filtration ℝ≥0 mΩ) (μ : Measure (ℝ × Ω)) :=
  lpMeas ℝ ℝ (predictableSpace (toCF 𝓖)) 2 μ

instance predL2_complete (𝓖 : Filtration ℝ≥0 mΩ) (μ : Measure (ℝ × Ω)) :
    CompleteSpace (PredL2 𝓖 μ) := by
  let _ : Fact (predictableSpace (toCF 𝓖) ≤ (inferInstance : MeasurableSpace (ℝ × Ω))) :=
    ⟨predictableSpace_le _⟩
  infer_instance

variable (𝓖 : Filtration ℝ≥0 mΩ) (T : ℝ≥0) (μ : Measure (ℝ × Ω)) [IsFiniteMeasure μ]

/-- The `L²(μ)` class of `c 1_S`. -/
def indLp {S : Set (ℝ × Ω)} (hS : MeasurableSet S) (c : ℝ) : Lp ℝ 2 μ :=
  indicatorConstLp 2 hS (measure_ne_top μ S) c

/-- The class of a rectangle `1_{(s,t] × A}` in `PredL2`. -/
def rectL2 (r : Rect 𝓖 T) : PredL2 𝓖 μ :=
  ⟨indLp μ r.measurableSet 1, mem_lpMeas_indicatorConstLp (predictableSpace_le _)
    r.measurableSet_pred (measure_ne_top μ _)⟩

@[simp] theorem rectL2_coe (r : Rect 𝓖 T) :
    ((rectL2 𝓖 T μ r : PredL2 𝓖 μ) : Lp ℝ 2 μ) = indLp μ r.measurableSet 1 := rfl

/-- The span of the rectangle classes (the simple predictable integrands). -/
def rectSpan : Submodule ℝ (PredL2 𝓖 μ) := Submodule.span ℝ (range (rectL2 𝓖 T μ))

variable {μ}

theorem indLp_congr {S S' : Set (ℝ × Ω)} (hS : MeasurableSet S) (hS' : MeasurableSet S')
    (h : S =ᵐ[μ] S') (c : ℝ) : indLp μ hS c = indLp μ hS' c := by
  unfold indLp indicatorConstLp
  exact (MemLp.toLp_eq_toLp_iff _ _).2 (indicator_ae_eq_of_ae_eq_set h)

theorem indLp_smul {S : Set (ℝ × Ω)} (hS : MeasurableSet S) (c : ℝ) :
    indLp μ hS c = c • indLp μ hS 1 := by
  refine Lp.ext ?_
  filter_upwards [Lp.coeFn_smul c (indLp μ hS 1),
    indicatorConstLp_coeFn (p := 2) (μ := μ) (hs := hS) (hμs := measure_ne_top μ S) (c := c),
    indicatorConstLp_coeFn (p := 2) (μ := μ) (hs := hS) (hμs := measure_ne_top μ S)
      (c := (1 : ℝ))] with x h1 h2 h3
  rw [h1]
  change indLp μ hS c x = c • (indLp μ hS 1 x)
  unfold indLp
  rw [h2, h3]
  by_cases hx : x ∈ S <;> simp [hx]

/-- The span seen inside `L²(μ)`, and its closure. -/
def rectSpanLp : Submodule ℝ (Lp ℝ 2 μ) :=
  ((rectSpan 𝓖 T μ).map (lpMeas ℝ ℝ (predictableSpace (toCF 𝓖)) 2 μ).subtype).topologicalClosure

theorem rectSpanLp_isClosed : IsClosed (rectSpanLp 𝓖 T (μ := μ) : Set (Lp ℝ 2 μ)) :=
  Submodule.isClosed_topologicalClosure _

theorem rect_mem_rectSpanLp (r : Rect 𝓖 T) (c : ℝ) :
    indLp μ r.measurableSet c ∈ rectSpanLp 𝓖 T (μ := μ) := by
  refine Submodule.le_topologicalClosure _ ⟨c • rectL2 𝓖 T μ r,
    Submodule.smul_mem _ c (Submodule.subset_span ⟨r, rfl⟩), ?_⟩
  rw [indLp_smul]
  rfl

/-- Indicator classes of predictable sets lie in the closed span, by the π-λ theorem. -/
theorem indLp_mem_rectSpanLp (hμ : ∀ᵐ x ∂μ, x.1 ∈ Ioc (0 : ℝ) T) :
    ∀ (S : Set (ℝ × Ω)) (hS : MeasurableSet[predictableSpace (toCF 𝓖)] S) (c : ℝ),
      indLp μ (predictableSpace_le _ S hS) c ∈ rectSpanLp 𝓖 T (μ := μ) := by
  let C : ∀ S : Set (ℝ × Ω), MeasurableSet[predictableSpace (toCF 𝓖)] S → Prop :=
    fun S _ => ∀ (hS' : MeasurableSet S) (c : ℝ), indLp μ hS' c ∈ rectSpanLp 𝓖 T (μ := μ)
  have hstrip : ∀ S : Set (ℝ × Ω), S =ᵐ[μ] (S ∩ (Ioc (0 : ℝ) T ×ˢ (univ : Set Ω)) : Set _) := by
    intro S
    filter_upwards [hμ] with x hx
    simp [hx]
  have hempty : ∀ (h0 : MeasurableSet (∅ : Set (ℝ × Ω))) (c : ℝ),
      indLp μ h0 c ∈ rectSpanLp 𝓖 T (μ := μ) := by
    intro h0 c
    have : indLp μ h0 c = 0 := indicatorConstLp_empty
    rw [this]; exact Submodule.zero_mem _
  have huniv : ∀ (hU : MeasurableSet (univ : Set (ℝ × Ω))) (c : ℝ),
      indLp μ hU c ∈ rectSpanLp 𝓖 T (μ := μ) := by
    intro hU c
    let r : Rect 𝓖 T := ⟨0, T, univ, zero_le, le_rfl, MeasurableSet.univ⟩
    rw [indLp_congr hU r.measurableSet ((hstrip univ).trans (by simp [r, Rect.set]))]
    exact rect_mem_rectSpanLp 𝓖 T r c
  intro S hS
  refine (@MeasurableSpace.induction_on_inter _ (predictableSpace (toCF 𝓖)) C _ rfl
    (predictableGenerators_isPiSystem _) ?_ ?_ ?_ ?_ S hS) (predictableSpace_le _ S hS)
  · exact hempty
  · intro S hgen hS' c
    rcases predictableGenerator_classification _ S hgen with ⟨A, -, rfl⟩ | ⟨s, t, A, hA, rfl⟩
    · have h0 : (({0} : Set ℝ) ×ˢ A) ∩ (Ioc (0 : ℝ) T ×ˢ (univ : Set Ω)) = ∅ := by
        ext x; simp only [mem_inter_iff, mem_prod, mem_singleton_iff, mem_Ioc, mem_univ,
          and_true, mem_empty_iff_false, iff_false, not_and]
        intro h1 _ h2; linarith
      rw [indLp_congr hS' MeasurableSet.empty ((hstrip _).trans (by rw [h0]))]
      exact hempty _ c
    · have hI : Ioc (s : ℝ) t ×ˢ A ∩ (Ioc (0 : ℝ) T ×ˢ (univ : Set Ω)) =
          Ioc (s : ℝ) (min t T : ℝ≥0) ×ˢ A := by
        rw [prod_inter_prod, Ioc_inter_Ioc, inter_univ, max_eq_left s.coe_nonneg,
          NNReal.coe_min]
      by_cases hst : s ≤ min t T
      · let r : Rect 𝓖 T := ⟨s, min t T, A, hst, min_le_right _ _, hA⟩
        rw [indLp_congr hS' r.measurableSet ((hstrip _).trans (by rw [hI]; rfl))]
        exact rect_mem_rectSpanLp 𝓖 T r c
      · have he : Ioc (s : ℝ) (min t T : ℝ≥0) ×ˢ A = ∅ := by
          rw [Ioc_eq_empty_of_le (by exact_mod_cast (not_le.1 hst).le), empty_prod]
        rw [indLp_congr hS' MeasurableSet.empty ((hstrip _).trans (by rw [hI, he]))]
        exact hempty _ c
  · intro S hSp hC hSc c
    have hS' : MeasurableSet S := predictableSpace_le _ S hSp
    have hU := indicatorConstLp_disjoint_union (p := 2) (μ := μ) hS' hS'.compl
      (measure_ne_top μ _) (measure_ne_top μ _) disjoint_compl_right c
    have hEq : indLp μ hSc c = indLp μ (hS'.union hS'.compl) c - indLp μ hS' c := by
      unfold indLp; rw [hU]; abel
    rw [hEq]
    refine Submodule.sub_mem _ ?_ (hC hS' c)
    rw [indLp_congr _ MeasurableSet.univ (by rw [union_compl_self])]
    exact huniv _ c
  · intro f hdisj hfm hC hU c
    let a : ℕ → Set (ℝ × Ω) := fun n => Set.accumulate f n
    have ham : ∀ n, MeasurableSet (a n) := fun n =>
      MeasurableSet.iUnion fun i => MeasurableSet.iUnion fun _ =>
        predictableSpace_le _ _ (hfm i)
    have hamem : ∀ n, indLp μ (ham n) c ∈ rectSpanLp 𝓖 T (μ := μ) := by
      intro n
      induction n with
      | zero =>
          rw [indLp_congr _ (predictableSpace_le _ _ (hfm 0)) (by simp [a])]
          exact hC 0 _ c
      | succ n ih =>
          have heq : a (n + 1) = a n ∪ f (n + 1) := by
            simp only [a, Set.accumulate_succ]
          have hd : Disjoint (a n) (f (n + 1)) := by
            exact Set.disjoint_accumulate hdisj (Nat.lt_succ_self n)
          have hU2 := indicatorConstLp_disjoint_union (p := 2) (μ := μ) (ham n)
            (predictableSpace_le _ _ (hfm (n + 1))) (measure_ne_top μ _) (measure_ne_top μ _)
            hd c
          rw [indLp_congr _ ((ham n).union (predictableSpace_le _ _ (hfm (n + 1))))
            (by rw [heq])]
          change indicatorConstLp 2 _ _ c ∈ _
          rw [hU2]
          exact Submodule.add_mem _ ih (hC (n + 1) _ c)
    have hmeas : Tendsto (fun n => μ (symmDiff (a n) (⋃ i, f i))) atTop (𝓝 0) := by
      have hsub (n : ℕ) : a n ⊆ ⋃ i, f i := Set.accumulate_subset_iUnion n
      have hbelow : Tendsto (fun n => μ (a n)) atTop (𝓝 (μ (⋃ i, f i))) := by
        simpa [a] using tendsto_measure_iUnion_accumulate (μ := μ) (s := f)
      have hs := ENNReal.Tendsto.sub tendsto_const_nhds hbelow
        (Or.inl (measure_ne_top μ (⋃ i, f i)))
      rw [tsub_self] at hs
      refine hs.congr fun n => ?_
      rw [symmDiff_of_le (hsub n), measure_sdiff (hsub n) (ham n).nullMeasurableSet
        (measure_ne_top μ _)]
    have hlim : Tendsto (fun n => indLp μ (ham n) c) atTop (𝓝 (indLp μ hU c)) :=
      tendsto_indicatorConstLp_set (p := 2) (by norm_num) hmeas
    exact (rectSpanLp_isClosed 𝓖 T).mem_of_tendsto hlim
      (Eventually.of_forall hamem)

/-- **Density of simple predictable integrands** in `PredL2 𝓖 μ`, for every finite `μ`
concentrated on `(0,T] × Ω` and every raw filtration. -/
theorem rectSpan_dense (hμ : ∀ᵐ x ∂μ, x.1 ∈ Ioc (0 : ℝ) T) :
    Dense (rectSpan 𝓖 T μ : Set (PredL2 𝓖 μ)) := by
  have hall : ∀ f : Lp ℝ 2 μ, AEStronglyMeasurable[predictableSpace (toCF 𝓖)] f μ →
      f ∈ rectSpanLp 𝓖 T (μ := μ) := by
    intro f hf
    refine Lp.induction_stronglyMeasurable (predictableSpace_le _) (by norm_num)
      (fun g => g ∈ rectSpanLp 𝓖 T (μ := μ)) ?_ ?_ ?_ f hf
    · intro c S hS _
      exact indLp_mem_rectSpanLp 𝓖 T hμ S hS c
    · intro u v _ _ _ _ _ hu hv
      exact Submodule.add_mem _ hu hv
    · exact (rectSpanLp_isClosed 𝓖 T).preimage continuous_subtype_val
  intro f
  rw [Topology.IsInducing.subtypeVal.closure_eq_preimage_closure_image]
  change (f : Lp ℝ 2 μ) ∈ closure (Subtype.val '' (rectSpan 𝓖 T μ : Set (PredL2 𝓖 μ)))
  have h2 := hall f f.2
  rw [rectSpanLp, ← SetLike.mem_coe, Submodule.topologicalClosure_coe, Submodule.map_coe] at h2
  exact h2

end BlockBand.SourceProcess.Stochastic.GeneralIntegral
