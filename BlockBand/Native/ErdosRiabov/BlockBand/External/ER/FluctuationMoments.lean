module

public import BlockBand.Native.ErdosRiabov.BlockBand.External.ER.GaussianCoordinateExpansion

/-!
# Finite fluctuation-moment recursions for the Gaussian ER expansion

The part of high-moment fluctuation averaging that is available without assuming a local
law: the signed, covariance-weighted resolvent fluctuation of `ERConcrete`
(`signedResolventError`), its even absolute moments (`evenFluctuationMoment`), and the
finite Wick bound `wickBound σ` generated by `m_{q+1} ≤ (2q+1) σ² m_q`, `m₀ = 1`.

No stochastic domination, all-order moment bound, self-consistency estimate, or
local law is assumed here.

Source: Erdős–Riabov, arXiv:2506.06441v1, fluctuation averaging in the proof
of Theorem 3.3.
-/

set_option autoImplicit false

@[expose] public section

noncomputable section

namespace ERNative.BlockBand
namespace GaussianRing
namespace ERFluctuationMoments

open Matrix MeasureTheory ProbabilityTheory ERLocalLaw ERConcrete
open scoped BigOperators ENNReal NNReal

local instance (p : Params) : NeZero p.n := p.nNeZero

/-!
## The signed fluctuation and its finite moments
-/

/-- The signed covariance-weighted resolvent error whose fluctuation moments
are estimated: the random variable `weightedFluctuation` itself, not its norm or a centered
surrogate. -/
def signedResolventError {p : Params} (M : Law p) (z : ℂ)
    (x y : Site p.n p.W) : M.Ω → ℂ :=
  weightedFluctuation M z x y

/-- The `2q`-th absolute moment of the signed resolvent error. -/
def evenFluctuationMoment {p : Params} (M : Law p) (z : ℂ)
    (x y : Site p.n p.W) (q : ℕ) : ℝ :=
  ∫ ω, ‖signedResolventError M z x y ω‖ ^ (2 * q) ∂M.P

/-- The zeroth fluctuation moment is one under the Gaussian-ring probability
law. -/
@[simp] theorem evenFluctuationMoment_zero
    {p : Params} (M : Law p) (z : ℂ) (x y : Site p.n p.W) :
    evenFluctuationMoment M z x y 0 = 1 := by
  simp [evenFluctuationMoment]

/-!
## Exact scalar Wick recursion from Gaussian IBP
-/

/-!
## Closing an explicit finite IBP/Ward recursion
-/

/-- The finite Wick bound generated by `m_{q+1} ≤ (2q+1) σ² m_q` and
`m₀ = 1`. -/
def wickBound (σ : ℝ) : ℕ → ℝ
  | 0 => 1
  | q + 1 => (2 * q + 1 : ℝ) * σ ^ 2 * wickBound σ q

@[simp] theorem wickBound_zero (σ : ℝ) : wickBound σ 0 = 1 := rfl

@[simp] theorem wickBound_succ (σ : ℝ) (q : ℕ) :
    wickBound σ (q + 1) =
      (2 * q + 1 : ℝ) * σ ^ 2 * wickBound σ q := rfl

/-!
## Ward reductions used by the recursion
-/

end ERFluctuationMoments
end GaussianRing
end ERNative.BlockBand
