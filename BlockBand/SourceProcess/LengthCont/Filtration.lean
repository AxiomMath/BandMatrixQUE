module

public import BlockBand.SourceProcess.ComplexSourceLaw.Measurability

/-!
# The length filtration of the probed path, and adaptedness of the source data

`probedSigma W np n` is the σ-algebra of the probed path generated by the first `n` blocks
`A_0, …, A_{n-1}`, the first `n + 1` bonds `B_0, …, B_n` and all tag Gaussians `g`. This is the
`growthSigma` of `TransmissionPath` together with the tags. The path of length `n` (`pathAt W n`)
reads only these coordinates, so the source data at length `n` is `probedSigma n`-measurable
(`measurable_complexSourceData_sigma`). The σ-algebras increase with `n`.
-/

set_option autoImplicit false

@[expose] public section
noncomputable section

namespace BlockBand.SourceProcess.LengthCont

open MeasureTheory
open BlockBand.Internal.Contracts.TransmissionPath BlockBand.Internal.Contracts.TransmissionLaws
open BlockBand.SourceProcess.ComplexSourceLaw

/-- The coordinates observed at length `n`: blocks `< n`, bonds `≤ n`, all tags. -/
abbrev Obs (W np n : ℕ) :=
  ((Fin n → Matrix (Fin W) (Fin W) ℂ) × (Fin (n + 1) → Matrix (Fin W) (Fin W) ℂ)) ×
    (Fin np → Fin W → ℂ)

/-- Restriction of a probed path to the coordinates observed at length `n`. -/
def obsAt (W np n : ℕ) (x : ProbedPath W np) : Obs W np n :=
  ((fun k => x.1.1 k, fun k => x.1.2 k), x.2)

/-- Extension by zero of observed coordinates to a probed path. -/
def obsExtend (W np n : ℕ) (y : Obs W np n) : ProbedPath W np :=
  ((fun k => if h : k < n then y.1.1 ⟨k, h⟩ else 0,
    fun k => if h : k < n + 1 then y.1.2 ⟨k, h⟩ else 0), y.2)

/-- The length-`n` σ-algebra of the probed path. -/
abbrev probedSigma (W np n : ℕ) : MeasurableSpace (ProbedPath W np) :=
  MeasurableSpace.comap (obsAt W np n) inferInstance

theorem measurable_obsAt (W np n : ℕ) : Measurable (obsAt W np n) := by
  unfold obsAt; fun_prop

theorem measurable_obsExtend (W np n : ℕ) : Measurable (obsExtend W np n) := by
  refine (Measurable.prodMk ?_ ?_).prodMk measurable_snd
  · refine Measurable.of_eval fun k => ?_
    by_cases h : k < n
    · simp only [h, ↓reduceDIte]
      exact (measurable_pi_apply _).comp (measurable_fst.comp measurable_fst)
    · simp only [h, ↓reduceDIte]
      exact measurable_const
  · refine Measurable.of_eval fun k => ?_
    by_cases h : k < n + 1
    · simp only [h, ↓reduceDIte]
      exact (measurable_pi_apply _).comp (measurable_snd.comp measurable_fst)
    · simp only [h, ↓reduceDIte]
      exact measurable_const

theorem probedSigma_le (W np n : ℕ) :
    probedSigma W np n ≤ (inferInstance : MeasurableSpace (ProbedPath W np)) :=
  (measurable_obsAt W np n).comap_le

theorem probedSigma_mono (W np : ℕ) : Monotone (probedSigma W np) := by
  intro n n' hn
  have hproj : Measurable fun y : Obs W np n' =>
      (((fun k : Fin n => y.1.1 (Fin.castLE hn k)),
        (fun k : Fin (n + 1) => y.1.2 (Fin.castLE (Nat.succ_le_succ hn) k))), y.2) := by
    fun_prop
  have h : Measurable[probedSigma W np n'] (obsAt W np n) :=
    hproj.comp (comap_measurable (obsAt W np n'))
  exact h.comap_le

/-- The path of length `n` reads only the coordinates observed at length `n`. -/
theorem pathAt_obsExtend (W np n : ℕ) (x : ProbedPath W np) :
    pathAt W n (obsExtend W np n (obsAt W np n x)).1 = pathAt W n x.1 := by
  simp only [pathAt, obsExtend, obsAt]
  refine Prod.ext ?_ (Prod.ext ?_ ?_)
  · funext i
    simp only
    split_ifs with h <;> first | rfl | (exfalso; omega)
  · funext i
    simp only
    split_ifs with h <;> first | rfl | (exfalso; omega)
  · funext i
    fin_cases i
    · simp only [Fin.zero_eta, Fin.isValue, Matrix.cons_val_zero]
      split_ifs with h <;> first | rfl | (exfalso; omega)
    · simp only [Fin.mk_one, Fin.isValue, Matrix.cons_val_one, Matrix.cons_val_fin_one]
      split_ifs with h <;> first | rfl | (exfalso; omega)

theorem fullInverse_obsExtend (b E : ℝ) (W np n : ℕ) (x : ProbedPath W np) :
    fullInverse b E W n (obsExtend W np n (obsAt W np n x)).1 = fullInverse b E W n x.1 := by
  simp only [fullInverse, fullPathMatrix, pathAt_obsExtend]

/-- The source data at length `n` is a function of the coordinates observed at length `n`. -/
theorem complexSourceData_obsExtend (b E : ℝ) {np : ℕ} (W n : ℕ) (τ m : Fin np → ℝ)
    (x : ProbedPath W np) :
    complexSourceData b E W n τ m (obsExtend W np n (obsAt W np n x)) =
      complexSourceData b E W n τ m x := by
  have h := fullInverse_obsExtend b E W np n x
  simp only [complexSourceData, complexSourceK, probeFrame, boundaryToInterior, pathCurrent,
    scatteringMatrix, boundaryResolvent, h]
  rfl

/-- **Adaptedness**: the source data at length `n` is `probedSigma n`-measurable. -/
theorem measurable_complexSourceData_sigma (b E : ℝ) {np : ℕ} (W n : ℕ) (τ m : Fin np → ℝ) :
    Measurable[probedSigma W np n] (complexSourceData b E W n τ m) := by
  have h : complexSourceData b E W n τ m =
      (fun y => complexSourceData b E W n τ m (obsExtend W np n y)) ∘ obsAt W np n :=
    funext fun x => (complexSourceData_obsExtend b E W n τ m x).symm
  rw [h]
  exact ((measurable_complexSourceData b E W n τ m).comp (measurable_obsExtend W np n)).comp
    (comap_measurable (obsAt W np n))

end BlockBand.SourceProcess.LengthCont
