
module

public import BlockBand.SourceProcess.FiniteDriverIntegration.ContinuousIto
public import Mathlib.MeasureTheory.Function.SimpleFuncDenseLp

/-!
# Density closure for predictable `L²`

Finite linear combinations of constant indicators of predictable sets are dense in
`PredictableL2`; this does not use the Brownian coordinates. Consequently the elementary
finite-step submodule is dense as soon as it approximates every predictable indicator.

The predictable sigma algebra is generated by `{0} × A` and `(s,t] × A`, with `A ∈ F_s`; the norm
is that of `L²(dt × P)` on `(0,T]`.
-/

set_option autoImplicit false

@[expose] public section
noncomputable section

namespace BlockBand.SourceProcess.FiniteDriverIntegration.ContinuousItoDensityClosure

open scoped ENNReal NNReal BigOperators
open MeasureTheory ProbabilityTheory Set
open ContinuousIto

/-- The predictable `L²` class of a constant indicator of a predictable set. -/
def predictableIndicatorL2 {Ω : Type*} [MeasurableSpace Ω]
    (ℱ : ContinuousFiltration Ω) (T : ℝ≥0) (P : Measure Ω)
    [IsFiniteMeasure (timeProbMeasure T P)] {s : Set (ℝ × Ω)}
    (hs : MeasurableSet[predictableSpace ℱ] s) (c : ℝ) :
    PredictableL2 ℱ T P := by
  let hm := predictableSpace_le ℱ
  let hμs : timeProbMeasure T P s ≠ ∞ := measure_ne_top _ _
  exact ⟨indicatorConstLp 2 (hm s hs) hμs c,
    mem_lpMeas_indicatorConstLp hm hs hμs⟩

/-- The submodule of predictable `L²` generated by constant indicators of arbitrary
predictable sets. -/
def predictableIndicatorSubmodule {Ω : Type*} [MeasurableSpace Ω]
    (ℱ : ContinuousFiltration Ω) (T : ℝ≥0) (P : Measure Ω)
    [IsFiniteMeasure (timeProbMeasure T P)] :
    Submodule ℝ (PredictableL2 ℱ T P) :=
  Submodule.span ℝ {f | ∃ s, ∃ hs : MeasurableSet[predictableSpace ℱ] s, ∃ c,
    f = predictableIndicatorL2 ℱ T P hs c}

/-- Every predictable constant indicator belongs to the indicator span. -/
theorem predictableIndicatorL2_mem {Ω : Type*} [MeasurableSpace Ω]
    (ℱ : ContinuousFiltration Ω) (T : ℝ≥0) (P : Measure Ω)
    [IsFiniteMeasure (timeProbMeasure T P)] {s : Set (ℝ × Ω)}
    (hs : MeasurableSet[predictableSpace ℱ] s) (c : ℝ) :
    predictableIndicatorL2 ℱ T P hs c ∈
      predictableIndicatorSubmodule ℱ T P := by
  apply Submodule.subset_span
  exact ⟨s, hs, c, rfl⟩

/-- A closed predictable submodule which contains every predictable constant indicator
is the whole predictable `L²` space (the closed-span form of simple-function density). -/
theorem closed_eq_top_of_indicator_mem {Ω : Type*} [MeasurableSpace Ω]
    (ℱ : ContinuousFiltration Ω) (T : ℝ≥0) (P : Measure Ω)
    [IsFiniteMeasure (timeProbMeasure T P)]
    (M : Submodule ℝ (PredictableL2 ℱ T P))
    (hM : IsClosed (↑M : Set (PredictableL2 ℱ T P)))
    (hind : ∀ (s : Set (ℝ × Ω))
      (hs : MeasurableSet[predictableSpace ℱ] s) (c : ℝ),
      predictableIndicatorL2 ℱ T P hs c ∈ M) :
    M = ⊤ := by
  apply top_unique
  intro f hf
  let Q : Lp ℝ 2 (timeProbMeasure T P) → Prop := fun g =>
    ∀ hg : AEStronglyMeasurable[predictableSpace ℱ] (g : ℝ × Ω → ℝ)
      (timeProbMeasure T P),
      (⟨g, hg⟩ : PredictableL2 ℱ T P) ∈ M
  have hclosed : IsClosed {g : PredictableL2 ℱ T P |
      Q (g : Lp ℝ 2 (timeProbMeasure T P))} := by
    have heq : {g : PredictableL2 ℱ T P |
        Q (g : Lp ℝ 2 (timeProbMeasure T P))} = (M : Set _) := by
      ext g
      simp only [Set.mem_ofPred_eq, SetLike.mem_coe]
      constructor
      · intro hg
        exact hg g.property
      · intro hg hmeas
        have hsub : (⟨(g : Lp ℝ 2 (timeProbMeasure T P)), hmeas⟩ : PredictableL2 ℱ T P) = g := by
          apply Subtype.ext
          rfl
        rwa [hsub]
    rw [heq]
    exact hM
  have hQ : ∀ g : Lp ℝ 2 (timeProbMeasure T P),
      AEStronglyMeasurable[predictableSpace ℱ] (g : ℝ × Ω → ℝ)
        (timeProbMeasure T P) → Q g := by
    intro g hg
    refine Lp.induction_stronglyMeasurable (predictableSpace_le ℱ)
      (p := (2 : ℝ≥0∞)) (μ := timeProbMeasure T P) (by norm_num) Q ?_ ?_ hclosed g hg
    · intro c s hs hμs hmeas
      have heq : (⟨Lp.simpleFunc.indicatorConst 2 ((predictableSpace_le ℱ) s hs) hμs.ne c,
          hmeas⟩ : PredictableL2 ℱ T P) =
          predictableIndicatorL2 ℱ T P hs c := by
        apply Subtype.ext
        rfl
      rw [heq]
      exact hind s hs c
    · intro u v hu hv hus hvs huv hQu hQv hmeas
      have humeas := hus.aestronglyMeasurable.congr hu.coeFn_toLp.symm
      have hvmeas := hvs.aestronglyMeasurable.congr hv.coeFn_toLp.symm
      have huM := hQu humeas
      have hvM := hQv hvmeas
      have heq : (⟨hu.toLp u + hv.toLp v, hmeas⟩ : PredictableL2 ℱ T P) =
          (⟨hu.toLp u, humeas⟩ : PredictableL2 ℱ T P) +
            ⟨hv.toLp v, hvmeas⟩ := by
        apply Subtype.ext
        rfl
      rw [heq]
      exact M.add_mem huM hvM
  exact hQ (f : Lp ℝ 2 (timeProbMeasure T P)) f.property f.property

/-- Predictable constant indicators have dense real linear span. -/
theorem predictableIndicatorSubmodule_dense {Ω : Type*} [MeasurableSpace Ω]
    (ℱ : ContinuousFiltration Ω) (T : ℝ≥0) (P : Measure Ω)
    [IsFiniteMeasure (timeProbMeasure T P)] :
    Dense (predictableIndicatorSubmodule ℱ T P : Set (PredictableL2 ℱ T P)) := by
  rw [dense_iff_closure_eq]
  have htop : (predictableIndicatorSubmodule ℱ T P).topologicalClosure = ⊤ := by
    apply closed_eq_top_of_indicator_mem ℱ T P
    · exact (predictableIndicatorSubmodule ℱ T P).isClosed_topologicalClosure
    · intro s hs c
      exact (predictableIndicatorSubmodule ℱ T P).le_topologicalClosure
        (predictableIndicatorL2_mem ℱ T P hs c)
  change ((predictableIndicatorSubmodule ℱ T P).topologicalClosure :
    Set (PredictableL2 ℱ T P)) = Set.univ
  rw [htop]
  rfl

/-- The elementary adapted rectangles of `ContinuousIto` are dense as soon as every predictable
constant indicator lies in the closure of the elementary submodule. -/
theorem elementary_dense_of_indicator_mem_closure {Ω : Type*}
    [MeasurableSpace Ω] (ℱ : ContinuousFiltration Ω) (T : ℝ≥0) (P : Measure Ω)
    [IsFiniteMeasure (timeProbMeasure T P)]
    (hind : ∀ (s : Set (ℝ × Ω))
      (hs : MeasurableSet[predictableSpace ℱ] s) (c : ℝ),
      predictableIndicatorL2 ℱ T P hs c ∈
        GridGeneratedPredictableL2 ℱ T P) :
    Dense (elementaryPredictableSubmodule ℱ T P : Set (PredictableL2 ℱ T P)) := by
  rw [elementary_dense_iff_gridGenerated_eq_top]
  apply closed_eq_top_of_indicator_mem ℱ T P
  · exact (elementaryPredictableSubmodule ℱ T P).isClosed_topologicalClosure
  · exact hind

/-- Two continuous linear maps that agree on the elementary adapted rectangles agree on all of
predictable `L²`, provided every predictable indicator is approximated by rectangles. -/
theorem continuousLinearMap_eq_of_eq_on_elementary {Ω : Type*}
    [MeasurableSpace Ω] (ℱ : ContinuousFiltration Ω) (T : ℝ≥0) (P : Measure Ω)
    [IsFiniteMeasure (timeProbMeasure T P)]
    (hind : ∀ (s : Set (ℝ × Ω))
      (hs : MeasurableSet[predictableSpace ℱ] s) (c : ℝ),
      predictableIndicatorL2 ℱ T P hs c ∈ GridGeneratedPredictableL2 ℱ T P)
    {F : Type*} [TopologicalSpace F] [AddCommMonoid F] [Module ℝ F] [T2Space F]
    (A B : PredictableL2 ℱ T P →L[ℝ] F)
    (hAB : ∀ x ∈ elementaryPredictableSubmodule ℱ T P, A x = B x) :
    A = B := by
  apply ContinuousIto.continuousLinearMap_eq_of_eq_on_dense
    (elementary_dense_of_indicator_mem_closure ℱ T P hind) A B
  intro x hx
  exact hAB x hx

end BlockBand.SourceProcess.FiniteDriverIntegration.ContinuousItoDensityClosure
