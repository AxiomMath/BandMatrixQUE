/-!
# Predictable `L²` foundations for continuous scalar Itô integration

This module constructs the predictable sigma algebra of a continuous filtration and the
complete `L²(dt × P)` quotient of predictable real processes.  It also gives the
isometric-completion mechanism which turns any compatible dense system of finite-grid
stochastic sums into a continuous integral (`continuous_integral_reduction`).

Mathlib supplies completeness of `lpMeas` and density of arbitrary measurable simple
functions.  Density of elementary adapted rectangles in predictable `L²` is reduced here
to `GridGeneratedPredictableL2 ℱ T P = ⊤` (`elementary_dense_iff_gridGenerated_eq_top`); it
is proved as
`ContinuousItoPredictableLambdaSystemClosure.elementaryPredictableSubmodule_dense`.
-/

set_option autoImplicit false

@[expose] public section

noncomputable section

namespace BlockBand.SourceProcess.FiniteDriverIntegration.ContinuousIto

open scoped ENNReal NNReal BigOperators
open MeasureTheory ProbabilityTheory Set

/-- A filtration indexed by nonnegative real time, subordinate to the ambient sigma
algebra. -/
structure ContinuousFiltration (Ω : Type*) [mΩ : MeasurableSpace Ω] where
  space : ℝ≥0 → MeasurableSpace Ω
  mono_space : Monotone space
  le_ambient : ∀ t, space t ≤ mΩ

/-- Standard generators of the predictable sigma algebra: time zero events and
left-adapted stochastic rectangles `(s,t] × A`, with `A ∈ F_s`. -/
def predictableGenerators {Ω : Type*} [MeasurableSpace Ω]
    (ℱ : ContinuousFiltration Ω) : Set (Set (ℝ × Ω)) :=
  {S | (∃ A, MeasurableSet[ℱ.space 0] A ∧ S = ({0} : Set ℝ) ×ˢ A) ∨
    ∃ s t A, MeasurableSet[ℱ.space s] A ∧ S = Set.Ioc (s : ℝ) (t : ℝ) ×ˢ A}

/-- The predictable sigma algebra generated by left-adapted rectangles. -/
@[instance_reducible] def predictableSpace {Ω : Type*} [MeasurableSpace Ω]
    (ℱ : ContinuousFiltration Ω) : MeasurableSpace (ℝ × Ω) :=
  MeasurableSpace.generateFrom (predictableGenerators ℱ)

/-- The predictable sigma algebra is a sub-sigma-algebra of the ambient product
sigma algebra. -/
theorem predictableSpace_le {Ω : Type*} [MeasurableSpace Ω]
    (ℱ : ContinuousFiltration Ω) :
    predictableSpace ℱ ≤ (inferInstance : MeasurableSpace (ℝ × Ω)) := by
  apply MeasurableSpace.generateFrom_le
  intro S hS
  rcases hS with ⟨A, hA, rfl⟩ | ⟨s, t, A, hA, rfl⟩
  · exact MeasurableSet.singleton 0 |>.prod (ℱ.le_ambient 0 A hA)
  · exact measurableSet_Ioc.prod (ℱ.le_ambient s A hA)

/-- A left-adapted stochastic rectangle is predictable by construction. -/
theorem measurableSet_predictableRectangle {Ω : Type*} [MeasurableSpace Ω]
    (ℱ : ContinuousFiltration Ω) {s t : ℝ≥0} {A : Set Ω}
    (hA : MeasurableSet[ℱ.space s] A) :
    MeasurableSet[predictableSpace ℱ]
      (Set.Ioc (s : ℝ) (t : ℝ) ×ˢ A) :=
  MeasurableSpace.measurableSet_generateFrom
    (show Set.Ioc (s : ℝ) (t : ℝ) ×ˢ A ∈ predictableGenerators ℱ from
      Or.inr ⟨s, t, A, hA, rfl⟩)

/-- A constant multiple of an adapted stochastic rectangle.  These are the
atomic finite-grid predictable processes used in constructive approximations. -/
def elementaryPredictable {Ω : Type*} [MeasurableSpace Ω]
    (s t : ℝ≥0) (A : Set Ω) (c : ℝ) : ℝ × Ω → ℝ :=
  (Set.Ioc (s : ℝ) (t : ℝ) ×ˢ A).indicator (fun _ => c)

theorem stronglyMeasurable_elementaryPredictable {Ω : Type*}
    [MeasurableSpace Ω] (ℱ : ContinuousFiltration Ω)
    {s t : ℝ≥0} {A : Set Ω} (hA : MeasurableSet[ℱ.space s] A) (c : ℝ) :
    StronglyMeasurable[predictableSpace ℱ]
      (elementaryPredictable s t A c) := by
  exact stronglyMeasurable_const.indicator
    (measurableSet_predictableRectangle ℱ hA)

/-- Time-probability measure on `[0,T] × Ω`.  The left-open convention matches the
predictable rectangles and is immaterial modulo `dt × P` null sets. -/
def timeProbMeasure {Ω : Type*} [MeasurableSpace Ω]
    (T : ℝ≥0) (P : Measure Ω) : Measure (ℝ × Ω) :=
  (volume.restrict (Set.Ioc 0 (T : ℝ))).prod P

instance timeProbMeasure_isFinite {Ω : Type*} [MeasurableSpace Ω]
    (T : ℝ≥0) (P : Measure Ω) [IsFiniteMeasure P] :
    IsFiniteMeasure (timeProbMeasure T P) := by
  unfold timeProbMeasure
  infer_instance

/-- Predictable real processes on `[0,T]`, modulo `dt × P` almost-everywhere equality,
with finite `L²` norm. -/
abbrev PredictableL2 {Ω : Type*} [MeasurableSpace Ω]
    (ℱ : ContinuousFiltration Ω) (T : ℝ≥0) (P : Measure Ω) :=
  lpMeas ℝ ℝ (predictableSpace ℱ) 2 (timeProbMeasure T P)

instance predictableL2_complete {Ω : Type*} [MeasurableSpace Ω]
    (ℱ : ContinuousFiltration Ω) (T : ℝ≥0) (P : Measure Ω) :
    CompleteSpace (PredictableL2 ℱ T P) := by
  let _ : Fact (predictableSpace ℱ ≤
      (inferInstance : MeasurableSpace (ℝ × Ω))) := ⟨predictableSpace_le ℱ⟩
  infer_instance

/-- Equality in predictable `L²` is precisely `dt × P` almost-everywhere equality of
its canonical representatives. -/
theorem predictableL2_eq_iff_ae_eq {Ω : Type*} [MeasurableSpace Ω]
    {ℱ : ContinuousFiltration Ω} {T : ℝ≥0} {P : Measure Ω}
    (f g : PredictableL2 ℱ T P) :
    f = g ↔ ((f : Lp ℝ 2 (timeProbMeasure T P)) : ℝ × Ω → ℝ) =ᵐ[timeProbMeasure T P]
      ((g : Lp ℝ 2 (timeProbMeasure T P)) : ℝ × Ω → ℝ) := by
  rw [Subtype.ext_iff, Lp.ext_iff]

/-- Every predictable `L²` class has a representative which is almost everywhere
strongly measurable for the predictable sigma algebra. -/
theorem predictableL2_aestronglyMeasurable {Ω : Type*} [MeasurableSpace Ω]
    {ℱ : ContinuousFiltration Ω} {T : ℝ≥0} {P : Measure Ω}
    (f : PredictableL2 ℱ T P) :
    AEStronglyMeasurable[predictableSpace ℱ]
      ((f : Lp ℝ 2 (timeProbMeasure T P)) : ℝ × Ω → ℝ)
      (timeProbMeasure T P) :=
  lpMeas.aestronglyMeasurable f

/-!
## Constructive finite predictable subspace
-/

/-- An elementary predictable rectangle, embedded in the predictable `L²` quotient.
Finiteness of `dt × P` is explicit; it holds in the Brownian application on a bounded
time interval. -/
def elementaryPredictableL2 {Ω : Type*} [MeasurableSpace Ω]
    (ℱ : ContinuousFiltration Ω) (T : ℝ≥0) (P : Measure Ω)
    [IsFiniteMeasure (timeProbMeasure T P)]
    {s t : ℝ≥0} {A : Set Ω} (hA : MeasurableSet[ℱ.space s] A) (c : ℝ) :
    PredictableL2 ℱ T P := by
  let f := elementaryPredictable s t A c
  have hpred : StronglyMeasurable[predictableSpace ℱ] f :=
    stronglyMeasurable_elementaryPredictable ℱ hA c
  have hamb : StronglyMeasurable f :=
    hpred.mono (predictableSpace_le ℱ)
  have hbound : ∀ x, ‖f x‖ ≤ ‖c‖ := by
    intro x
    simp only [f, elementaryPredictable]
    by_cases hx : x ∈ Set.Ioc (s : ℝ) (t : ℝ) ×ˢ A <;> simp [hx]
  have hf : MemLp f 2 (timeProbMeasure T P) :=
    MemLp.of_bound hamb.aestronglyMeasurable ‖c‖ (Filter.Eventually.of_forall hbound)
  refine ⟨hf.toLp f, ?_⟩
  exact hpred.aestronglyMeasurable.congr hf.coeFn_toLp.symm

/-- The linear subspace generated by elementary left-adapted rectangles.  This is
the finite-grid-generated predictable class available without a density theorem. -/
def elementaryPredictableSubmodule {Ω : Type*} [MeasurableSpace Ω]
    (ℱ : ContinuousFiltration Ω) (T : ℝ≥0) (P : Measure Ω)
    [IsFiniteMeasure (timeProbMeasure T P)] :
    Submodule ℝ (PredictableL2 ℱ T P) :=
  Submodule.span ℝ {f | ∃ s t A, ∃ hA : MeasurableSet[ℱ.space s] A, ∃ c,
    f = elementaryPredictableL2 ℱ T P (t := t) hA c}

/-- Finite linear combinations of adapted rectangles lie in the predictable `L²`
space by construction. -/
theorem elementaryPredictableL2_mem_submodule {Ω : Type*} [MeasurableSpace Ω]
    (ℱ : ContinuousFiltration Ω) (T : ℝ≥0) (P : Measure Ω)
    [IsFiniteMeasure (timeProbMeasure T P)]
    {s t : ℝ≥0} {A : Set Ω} (hA : MeasurableSet[ℱ.space s] A) (c : ℝ) :
    elementaryPredictableL2 ℱ T P (t := t) hA c ∈
      elementaryPredictableSubmodule ℱ T P := by
  apply Submodule.subset_span
  exact ⟨s, t, A, hA, c, rfl⟩

/-- The closure of the elementary adapted rectangles.  This is a complete,
finite-grid-generated predictable space even before full predictable density is known. -/
def GridGeneratedPredictableL2 {Ω : Type*} [MeasurableSpace Ω]
    (ℱ : ContinuousFiltration Ω) (T : ℝ≥0) (P : Measure Ω)
    [IsFiniteMeasure (timeProbMeasure T P)] :
    Submodule ℝ (PredictableL2 ℱ T P) :=
  (elementaryPredictableSubmodule ℱ T P).topologicalClosure

/-- Every grid-generated predictable process admits arbitrarily accurate `L²`
approximation by a finite linear combination of adapted rectangles. -/
theorem exists_elementary_approximation {Ω : Type*} [MeasurableSpace Ω]
    (ℱ : ContinuousFiltration Ω) (T : ℝ≥0) (P : Measure Ω)
    [IsFiniteMeasure (timeProbMeasure T P)]
    (f : GridGeneratedPredictableL2 ℱ T P) {ε : ℝ} (hε : 0 < ε) :
    ∃ g : PredictableL2 ℱ T P,
      g ∈ elementaryPredictableSubmodule ℱ T P ∧ dist (f : PredictableL2 ℱ T P) g < ε := by
  have hf :
      (f : PredictableL2 ℱ T P) ∈
        closure (elementaryPredictableSubmodule ℱ T P : Set (PredictableL2 ℱ T P)) := by
    exact f.property
  exact (Metric.mem_closure_iff.1 hf) ε hε

/-- Formulation of the density question: elementary adapted
rectangles are dense in all predictable `L²` exactly when their grid-generated
closed submodule is the whole space. -/
theorem elementary_dense_iff_gridGenerated_eq_top {Ω : Type*}
    [MeasurableSpace Ω] (ℱ : ContinuousFiltration Ω) (T : ℝ≥0) (P : Measure Ω)
    [IsFiniteMeasure (timeProbMeasure T P)] :
    Dense (elementaryPredictableSubmodule ℱ T P :
      Set (PredictableL2 ℱ T P)) ↔
      GridGeneratedPredictableL2 ℱ T P = ⊤ := by
  rw [dense_iff_closure_eq]
  constructor
  · intro h
    apply SetLike.ext
    intro x
    change x ∈ closure (elementaryPredictableSubmodule ℱ T P :
      Set (PredictableL2 ℱ T P)) ↔ x ∈ (⊤ :
        Submodule ℝ (PredictableL2 ℱ T P))
    rw [h]
    simp
  · intro h
    have hc := congrArg
      (fun M : Submodule ℝ (PredictableL2 ℱ T P) =>
        (M : Set (PredictableL2 ℱ T P))) h
    simpa [GridGeneratedPredictableL2] using hc

/-!
## The exact completion mechanism
-/

/-- The completion of a finite-step integrand space.  This is the grid-independent
space once common-refinement equivalence has been constructed on the finite-step
space `E`. -/
abbrev StepCompletion (E : Type*) [SeminormedAddCommGroup E] :=
  UniformSpace.Completion E

/-- An isometric finite-step stochastic integral extends canonically to the completed
integrand space. -/
def completedIntegral {E : Type*} [SeminormedAddCommGroup E] [NormedSpace ℝ E]
    [IsUniformAddGroup E] [UniformContinuousConstSMul ℝ E]
    {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F] [CompleteSpace F]
    (I : E →ₗᵢ[ℝ] F) : StepCompletion E →ₗᵢ[ℝ] F :=
  I.fromCompletion

@[simp] theorem completedIntegral_coe {E : Type*} [SeminormedAddCommGroup E]
    [NormedSpace ℝ E] [IsUniformAddGroup E] [UniformContinuousConstSMul ℝ E]
    {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F] [CompleteSpace F]
    (I : E →ₗᵢ[ℝ] F) (x : E) :
    completedIntegral I (x : StepCompletion E) = I x :=
  I.fromCompletion_apply_coe x

/-- Extend an isometric stochastic integral directly along a dense linear-isometric
embedding of finite step processes into the chosen predictable space. -/
def extendIntegralAlongDense
    {E : Type*} [SeminormedAddCommGroup E] [NormedSpace ℝ E]
    {G F : Type*} [NormedAddCommGroup G] [NormedSpace ℝ G]
    [NormedAddCommGroup F] [NormedSpace ℝ F] [CompleteSpace F]
    (e : E →ₗᵢ[ℝ] G) (he : DenseRange e) (I : E →ₗᵢ[ℝ] F) :
    G →ₗᵢ[ℝ] F :=
  I.toLinearMap.extendOfIsometry he (fun x => by
    simp)

@[simp] theorem extendIntegralAlongDense_apply
    {E : Type*} [SeminormedAddCommGroup E] [NormedSpace ℝ E]
    {G F : Type*} [NormedAddCommGroup G] [NormedSpace ℝ G]
    [NormedAddCommGroup F] [NormedSpace ℝ F] [CompleteSpace F]
    (e : E →ₗᵢ[ℝ] G) (he : DenseRange e) (I : E →ₗᵢ[ℝ] F) (x : E) :
    extendIntegralAlongDense e he I (e x) = I x :=
  I.toLinearMap.extendOfIsometry_eq he (fun y => by
    simp) x

/-- Precise reduction: if finite adapted step processes have already been assembled
into a seminormed space `E`, embedded densely and isometrically into predictable
`L²`, and their stochastic sums form a linear isometry into random-variable `L²`,
then the latter has a unique canonical isometric extension to the completion of `E`. -/
theorem continuous_integral_reduction
    {E : Type*} [SeminormedAddCommGroup E] [NormedSpace ℝ E]
    [IsUniformAddGroup E] [UniformContinuousConstSMul ℝ E]
    {G F : Type*} [NormedAddCommGroup G] [NormedSpace ℝ G] [CompleteSpace G]
    [NormedAddCommGroup F] [NormedSpace ℝ F] [CompleteSpace F]
    (e : E →ₗᵢ[ℝ] G) (he : DenseRange e)
    (I : E →ₗᵢ[ℝ] F) :
    ∃ J : G →ₗᵢ[ℝ] F, ∀ x : E, J (e x) = I x := by
  exact ⟨extendIntegralAlongDense e he I,
    extendIntegralAlongDense_apply e he I⟩

/-!
## Closed-property inheritance
-/

/-- Linear conditional-expectation identities proved on a dense finite-step class
extend to its completion.  This is the functional-analytic step needed to inherit
martingale identities once the concrete predictable-step embedding is dense. -/
theorem continuousLinearMap_eq_of_eq_on_dense
    {G F : Type*} [TopologicalSpace G] [AddCommMonoid G] [Module ℝ G]
    [TopologicalSpace F] [AddCommMonoid F] [Module ℝ F] [T2Space F]
    {S : Set G} (hS : Dense S) (A B : G →L[ℝ] F)
    (hAB : Set.EqOn A B S) : A = B := by
  have hfun : (A : G → F) = (B : G → F) :=
    A.continuous.ext_on hS B.continuous hAB
  ext x
  exact congrFun hfun x

/-- A continuous real-valued maximal estimate holding for finite adapted steps holds
on their closure. -/
theorem inequality_inherits_on_closure
    {G : Type*} [TopologicalSpace G] {S : Set G}
    (Φ Ψ : G → ℝ) (hΦ : Continuous Φ) (hΨ : Continuous Ψ)
    (hstep : ∀ x ∈ S, Φ x ≤ Ψ x) {x : G} (hx : x ∈ closure S) :
    Φ x ≤ Ψ x :=
  le_on_closure hstep hΦ.continuousOn hΨ.continuousOn hx

end BlockBand.SourceProcess.FiniteDriverIntegration.ContinuousIto
