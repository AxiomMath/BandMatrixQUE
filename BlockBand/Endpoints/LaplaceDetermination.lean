module

public import BlockBand.Endpoints.VagueMeasurability
public import BlockBand.PointProcess.Specifications
public import Mathlib.MeasureTheory.Measure.FiniteMeasureExt

/-!
# Laplace functionals determine laws of point measures

Proof: the countable nonnegative coordinates `ξ(h_j)` of
`VagueMeasurability` generate the Borel σ-algebra, hence so do the
exponential coordinates `exp(-ξ(h_j)) ∈ [0,1]`, which jointly map the vague
space into the compact Polish cube `VagueNonnegIndex → [0,1]`. The star
subalgebra of bounded continuous functions generated by the cube coordinates
separates points, and the integral of each of its monomials under the image
law is a Laplace functional at a nonnegative compact test. Mathlib's
subalgebra uniqueness theorem then identifies the image laws.

As corollaries, the explicit specifications `IsUnitPoissonLaw` and
`IsSineLaw` on `VaguePointMeasure ℝ` each determine at most one law.
No existence of either law is asserted here.
-/

set_option autoImplicit false

@[expose] public section

noncomputable section

namespace BlockBand.Endpoints

open MeasureTheory Set TopologicalSpace BoundedContinuousFunction
open BlockBand.Model.Construction

variable {X : Type*} [TopologicalSpace X] [MeasurableSpace X] [BorelSpace X]
  [T2Space X] [SecondCountableTopology X] [LocallyCompactSpace X]

/-- The countable cube `VagueNonnegIndex → [0,1]` (product topology). -/
abbrev VagueExpCube : Type := VagueNonnegIndex → unitInterval

variable (X) in
/-- Exponential nonnegative coordinates `ξ ↦ (exp(-ξ(h_j)))_j ∈ [0,1]^J`. -/
def vagueExpCoordinate (ξ : VaguePointMeasure X) : VagueExpCube := fun j =>
  ⟨Real.exp (-vagueNonnegCoordinate X ξ j), (Real.exp_pos _).le,
    Real.exp_le_one_iff.mpr (neg_nonpos.mpr (coordinate_nonneg ξ (vagueNonnegTest_nonneg j)))⟩

omit [BorelSpace X] in
/-- The exponential coordinate map is Borel measurable into the product
σ-algebra of the cube. -/
theorem measurable_vagueExpCoordinate : Measurable (vagueExpCoordinate X) :=
  Measurable.of_eval fun _ => ((measurable_coordinate _).neg.exp).subtype_mk

omit [BorelSpace X] in
/-- For every point measure `ξ` and index `j`, the nonnegative coordinate is
recovered as `-log` of the exponential coordinate. -/
theorem vagueNonnegCoordinate_eq_neg_log (ξ : VaguePointMeasure X) (j : VagueNonnegIndex) :
    vagueNonnegCoordinate X ξ j = -Real.log (vagueExpCoordinate X ξ j : ℝ) := by
  simp [vagueExpCoordinate, Real.log_exp]

/-- The Borel σ-algebra of `VaguePointMeasure X` is contained in (hence
equals) the pullback of the cube's product σ-algebra under the exponential
coordinates. -/
theorem borel_le_comap_vagueExpCoordinate :
    borel (VaguePointMeasure X) ≤
      MeasurableSpace.comap (vagueExpCoordinate X) MeasurableSpace.pi := by
  have hL : Measurable (fun y : VagueExpCube => fun j => -Real.log (y j : ℝ)) :=
    Measurable.of_eval fun j =>
      (Real.measurable_log.comp (measurable_subtype_coe.comp (measurable_pi_apply j))).neg
  have hfac : vagueNonnegCoordinate X =
      (fun y : VagueExpCube => fun j => -Real.log (y j : ℝ)) ∘ vagueExpCoordinate X := by
    funext ξ j
    exact vagueNonnegCoordinate_eq_neg_log ξ j
  rw [vaguePointMeasure_measurableSpace_eq_comap, hfac, ← MeasurableSpace.comap_comp]
  exact MeasurableSpace.comap_mono hL.comap_le

/-- Two (arbitrary) measures on the vague state space coincide when
their images under the exponential coordinate map coincide. -/
theorem measure_eq_of_map_vagueExpCoordinate_eq {μ ν : Measure (VaguePointMeasure X)}
    (h : μ.map (vagueExpCoordinate X) = ν.map (vagueExpCoordinate X)) : μ = ν := by
  ext s hs
  obtain ⟨t, ht, rfl⟩ :=
    MeasurableSpace.measurableSet_comap.mp (borel_le_comap_vagueExpCoordinate s hs)
  rw [← Measure.map_apply measurable_vagueExpCoordinate ht, h,
    Measure.map_apply measurable_vagueExpCoordinate ht]

/-- The `j`-th coordinate of the cube, as a bounded continuous real function. -/
def vagueExpCubeCoord (j : VagueNonnegIndex) : VagueExpCube →ᵇ ℝ :=
  mkOfCompact ⟨fun y => (y j : ℝ), by fun_prop⟩

/-- The star subalgebra of bounded continuous functions on the cube generated
by the coordinates (polynomials in finitely many coordinates). -/
def vagueExpAlgebra : StarSubalgebra ℝ (VagueExpCube →ᵇ ℝ) :=
  StarAlgebra.adjoin ℝ (Set.range vagueExpCubeCoord)

/-- The coordinate algebra separates the points of the cube. -/
theorem vagueExpAlgebra_separatesPoints :
    (vagueExpAlgebra.map (toContinuousMapStarₐ ℝ)).SeparatesPoints := by
  intro y y' hyy'
  obtain ⟨j, hj⟩ : ∃ j, y j ≠ y' j := by
    by_contra! hc
    exact hyy' (funext hc)
  use vagueExpCubeCoord j
  simp only [StarSubalgebra.coe_toSubalgebra, StarSubalgebra.coe_map, Set.mem_image,
    SetLike.mem_coe, exists_exists_and_eq_and, ne_eq]
  refine ⟨⟨vagueExpCubeCoord j, StarAlgebra.subset_adjoin ℝ _ ⟨j, rfl⟩, rfl⟩, ?_⟩
  intro h
  exact hj (Subtype.ext h)

/-- Every element `g` of the multiplicative monoid generated by the cube
coordinates (and their stars) is, along the exponential coordinates, an
exponential of a nonnegative compact coordinate: there is a pointwise
nonnegative `f ∈ C_c(X, ℝ)` with `g (vagueExpCoordinate X ξ) = exp(-ξ(f))`
for every point measure `ξ`. -/
theorem exists_test_of_mem_closure {g : VagueExpCube →ᵇ ℝ}
    (hg : g ∈ Submonoid.closure
      (Set.range vagueExpCubeCoord ∪ star (Set.range vagueExpCubeCoord))) :
    ∃ f : CompactlySupportedContinuousMap X ℝ, (∀ x, 0 ≤ f x) ∧
      ∀ ξ : VaguePointMeasure X,
        g (vagueExpCoordinate X ξ) = Real.exp (-ξ.coordinate f) := by
  induction hg using Submonoid.closure_induction with
  | mem g hg =>
    have hg' : g ∈ Set.range vagueExpCubeCoord := by
      rcases hg with hg | hg
      · exact hg
      · rw [Set.mem_star] at hg
        obtain ⟨j, hj⟩ := hg
        refine ⟨j, ?_⟩
        rw [hj]
        ext y
        simp [star_apply]
    obtain ⟨j, rfl⟩ := hg'
    exact ⟨vagueNonnegTest X j, vagueNonnegTest_nonneg j, fun ξ => rfl⟩
  | one =>
    refine ⟨0, fun _ => le_rfl, fun ξ => ?_⟩
    simp [VaguePointMeasure.coordinate]
  | mul g g' _ _ ihg ihg' =>
    obtain ⟨f, hf, hfg⟩ := ihg
    obtain ⟨f', hf', hfg'⟩ := ihg'
    refine ⟨f + f', fun x => add_nonneg (hf x) (hf' x), fun ξ => ?_⟩
    rw [BoundedContinuousFunction.mul_apply, hfg, hfg', coordinate_add, neg_add, Real.exp_add]

/-- Laplace determination. For Borel probability measures `μ, ν` on the
vague state space `VaguePointMeasure X`: if
`∫ exp(-∫ f dξ) dμ(ξ) = ∫ exp(-∫ f dξ) dν(ξ)` for every pointwise nonnegative
compactly supported continuous `f : X → ℝ`, then `μ = ν`. -/
theorem vaguePointMeasureLaw_eq_of_laplace (μ ν : ProbabilityMeasure (VaguePointMeasure X))
    (h : ∀ f : CompactlySupportedContinuousMap X ℝ, (∀ x, 0 ≤ f x) →
      ∫ ξ, Real.exp (-∫ x, f x ∂ξ.measure) ∂(μ : Measure (VaguePointMeasure X)) =
        ∫ ξ, Real.exp (-∫ x, f x ∂ξ.measure) ∂(ν : Measure (VaguePointMeasure X))) :
    μ = ν := by
  apply ProbabilityMeasure.toMeasure_injective
  apply measure_eq_of_map_vagueExpCoordinate_eq
  have hY := measurable_vagueExpCoordinate (X := X)
  have key (P : Measure (VaguePointMeasure X)) (g : VagueExpCube →ᵇ ℝ) :
      ∫ y, g y ∂(P.map (vagueExpCoordinate X)) = ∫ ξ, g (vagueExpCoordinate X ξ) ∂P :=
    integral_map hY.aemeasurable g.continuous.aestronglyMeasurable
  refine ext_of_forall_mem_subalgebra_integral_eq_of_polish vagueExpAlgebra_separatesPoints ?_
  intro g hg
  have hg' : g ∈ Submodule.span ℝ (Submonoid.closure
      (Set.range vagueExpCubeCoord ∪ star (Set.range vagueExpCubeCoord))) := by
    rw [← StarAlgebra.adjoin_eq_span]
    exact hg
  clear hg
  induction hg' using Submodule.span_induction with
  | mem g hg =>
    obtain ⟨f, hf, hfg⟩ := exists_test_of_mem_closure (X := X) hg
    rw [key, key]
    simp_rw [hfg]
    exact h f hf
  | zero => simp
  | add g g' _ _ ihg ihg' =>
    simp only [BoundedContinuousFunction.coe_add, Pi.add_apply]
    rw [integral_add (g.integrable _) (g'.integrable _),
      integral_add (g.integrable _) (g'.integrable _), ihg, ihg']
  | smul c g _ ihg =>
    simp only [BoundedContinuousFunction.coe_smul, smul_eq_mul]
    rw [integral_const_mul, integral_const_mul, ihg]

/-- Uniqueness of the unit Poisson law: any two probability measures on
`VaguePointMeasure ℝ` satisfying the specification `IsUnitPoissonLaw`
(unit-intensity Poisson Laplace functional for all nonnegative `C_c` tests)
are equal. -/
theorem isUnitPoissonLaw_unique {μ ν : ProbabilityMeasure (VaguePointMeasure ℝ)}
    (hμ : IsUnitPoissonLaw μ) (hν : IsUnitPoissonLaw ν) : μ = ν :=
  vaguePointMeasureLaw_eq_of_laplace μ ν fun f hf => (hμ f hf).trans (hν f hf).symm

/-- Uniqueness of the sine law: any two probability measures on
`VaguePointMeasure ℝ` satisfying the specification `IsSineLaw` (simple
a.s., with the sine-kernel Fredholm Laplace functional for all nonnegative
`C_c` tests) are equal. Only the Laplace clause is used. -/
theorem isSineLaw_unique {μ ν : ProbabilityMeasure (VaguePointMeasure ℝ)}
    (hμ : IsSineLaw μ) (hν : IsSineLaw ν) : μ = ν :=
  vaguePointMeasureLaw_eq_of_laplace μ ν fun f hf => (hμ.2 f hf).trans (hν.2 f hf).symm

end BlockBand.Endpoints
