module

public import BlockBand.Critical.EntireLaw.ConeGeneration
public import BlockBand.Critical.EntireLaw.Skeleton
public import BlockBand.Critical.EntireLaw.FiniteMoment
public import Mathlib.MeasureTheory.Measure.FiniteMeasureExt

/-!
# The entire law: bounded mixed inverse moments determine cone-bounded laws

Proof.
1. `inverseCubeMap`: `F ↦ (clampFactor 1 (F(i|q|)))_{q ∈ ℚ^m}`, continuous into the compact
   Polish cube `(ℚ^m) → closedBall 0 1`; on cone-bounded laws its coordinates are `F(i|q|)⁻¹` a.s.
2. Every monomial in the cube coordinates and their conjugates, composed with `inverseCubeMap`, is
   exactly a `momentTest` (`exists_momentTest_of_mem_closure`; conjugation is the sign `σ = -1`),
   whose integral is the mixed inverse moment (`mixedInverseMoment_eq_integral`). Mathlib's
   `ext_of_forall_mem_subalgebra_integral_eq_of_polish` (Stone–Weierstrass on the polydisk) gives
   equal image laws on the cube.
3. Inverting coordinatewise, the laws of the rational cone values `F ↦ (F(i|q|))_q` agree, and
   these values generate the Borel σ-algebra (`measurable_of_ratCone`, identity
   theorem in measurable form), so the laws agree (`measure_eq_of_map_ratConeValues_eq`).
-/

set_option autoImplicit false

@[expose] public section
noncomputable section

namespace BlockBand.Critical.EntireLaw

open MeasureTheory Filter Topology BoundedContinuousFunction
open BlockBand.Critical.Entire
open BlockBand.Internal.Contracts.CriticalEntire
open scoped ComplexConjugate

/-- The closed unit disk of `ℂ`. -/
abbrev UnitDisk : Type := Metric.closedBall (0 : ℂ) 1

/-- The countable polydisk cube indexed by rational source points. -/
abbrev InverseCube (m : ℕ) : Type := (Fin m → ℚ) → UnitDisk

/-- Rational cone point `y_a = |q_a|`. -/
def ratConeParam {m : ℕ} (q : Fin m → ℚ) : Fin m → ℝ := fun a => ((|q a| : ℚ) : ℝ)

theorem ratConeParam_nonneg {m : ℕ} (q : Fin m → ℚ) (a : Fin m) : 0 ≤ ratConeParam q a := by
  unfold ratConeParam; exact_mod_cast abs_nonneg (q a)

theorem mem_unitDisk_clampFactor (σ : ℤˣ) (w : ℂ) : clampFactor σ w ∈ Metric.closedBall (0 : ℂ) 1 := by
  rw [Metric.mem_closedBall, dist_zero_right]; exact norm_clampFactor_le σ w

/-- Clamped inverse values at the rational cone points. -/
def inverseCubeMap {m : ℕ} (F : EntireFunction m) : InverseCube m := fun q =>
  ⟨clampFactor 1 (F (conePoint (ratConeParam q))), mem_unitDisk_clampFactor 1 _⟩

theorem continuous_inverseCubeMap {m : ℕ} : Continuous (inverseCubeMap (m := m)) :=
  continuous_pi fun _ => ((continuous_clampFactor 1).comp
    (EntireFunction.continuous_eval_const _)).subtype_mk _

/-- Coordinate `q` of the cube. -/
def cubeCoord {m : ℕ} (q : Fin m → ℚ) : InverseCube m →ᵇ ℂ :=
  mkOfCompact ⟨fun u => (u q : ℂ), by fun_prop⟩

/-- The star subalgebra generated by the cube coordinates. -/
def cubeAlgebra (m : ℕ) : StarSubalgebra ℂ (InverseCube m →ᵇ ℂ) :=
  StarAlgebra.adjoin ℂ (Set.range cubeCoord)

theorem cubeAlgebra_separatesPoints (m : ℕ) :
    ((cubeAlgebra m).map (toContinuousMapStarₐ ℂ)).SeparatesPoints := by
  intro u u' huu'
  obtain ⟨q, hq⟩ : ∃ q, u q ≠ u' q := by
    by_contra! hc
    exact huu' (funext hc)
  use cubeCoord q
  simp only [StarSubalgebra.coe_toSubalgebra, StarSubalgebra.coe_map, Set.mem_image,
    SetLike.mem_coe, exists_exists_and_eq_and, ne_eq]
  refine ⟨⟨cubeCoord q, StarAlgebra.subset_adjoin ℂ _ ⟨q, rfl⟩, rfl⟩, ?_⟩
  intro h
  exact hq (Subtype.ext h)

theorem star_clampFactor_one (w : ℂ) : conj (clampFactor 1 w) = clampFactor (-1) w := by
  unfold clampFactor
  rw [map_div₀, Complex.conj_ofReal]
  simp

/-- Every monomial in the cube coordinates and their conjugates is a moment test. -/
theorem exists_momentTest_of_mem_closure {m : ℕ} {g : InverseCube m →ᵇ ℂ}
    (hg : g ∈ Submonoid.closure (Set.range cubeCoord ∪ star (Set.range cubeCoord))) :
    ∃ (J : ℕ) (y : Fin J → Fin m → ℝ) (σ : Fin J → ℤˣ), (∀ j a, 0 ≤ y j a) ∧
      ∀ F : EntireFunction m, g (inverseCubeMap F) = momentTest y σ F := by
  induction hg using Submonoid.closure_induction with
  | mem g hg =>
    rcases hg with ⟨q, rfl⟩ | hg
    · refine ⟨1, fun _ => ratConeParam q, fun _ => 1, fun _ a => ratConeParam_nonneg q a,
        fun F => ?_⟩
      simp [momentTest, cubeCoord, inverseCubeMap]
    · rw [Set.mem_star] at hg
      obtain ⟨q, hq⟩ := hg
      refine ⟨1, fun _ => ratConeParam q, fun _ => -1, fun _ a => ratConeParam_nonneg q a,
        fun F => ?_⟩
      have : g = star (cubeCoord q) := by rw [hq, star_star]
      rw [this]
      simp [momentTest, cubeCoord, inverseCubeMap, star_clampFactor_one]
  | one =>
    refine ⟨0, Fin.elim0, Fin.elim0, fun j => j.elim0, fun F => ?_⟩
    simp [momentTest]
  | mul g g' _ _ ihg ihg' =>
    obtain ⟨J, y, σ, hy, hg⟩ := ihg
    obtain ⟨J', y', σ', hy', hg'⟩ := ihg'
    refine ⟨J + J', Fin.append y y', Fin.append σ σ', fun j a => ?_, fun F => ?_⟩
    · refine Fin.addCases (fun j => ?_) (fun j => ?_) j
      · simpa using hy j a
      · simpa using hy' j a
    · rw [BoundedContinuousFunction.mul_apply, hg, hg']
      simp [momentTest, Fin.prod_univ_add]

/-- Cone values at the rational points `i|q|`. -/
def ratConeValues {m : ℕ} (F : EntireFunction m) : (Fin m → ℚ) → ℂ :=
  fun q => F (conePoint (ratConeParam q))

theorem measurable_ratConeValues {m : ℕ} : Measurable (ratConeValues (m := m)) :=
  Measurable.of_eval (X := fun _ : Fin m → ℚ => ℂ) fun _ =>
    EntireFunction.measurable_eval_const _

/-- The Borel σ-algebra of `EntireFunction m` is generated by the rational cone values. -/
theorem measurableSpace_le_comap_ratConeValues {m : ℕ} :
    (EntireFunction.instMeasurableSpace : MeasurableSpace (EntireFunction m)) ≤
      MeasurableSpace.comap (ratConeValues (m := m)) MeasurableSpace.pi := by
  have h := @measurable_of_ratCone m (EntireFunction m)
    (MeasurableSpace.comap (ratConeValues (m := m)) MeasurableSpace.pi) id fun q hq => by
      have hq' : (fun a => ((q a : ℚ) : ℂ) * Complex.I) = conePoint (ratConeParam q) := by
        funext a
        simp [conePoint, ratConeParam, abs_of_pos (hq a)]
      simp only [id]
      rw [hq']
      exact (show Measurable fun v : (Fin m → ℚ) → ℂ => v q from measurable_pi_apply q).comp
        (Measurable.of_comap_le le_rfl)
  exact fun s hs => h hs

theorem measure_eq_of_map_ratConeValues_eq {m : ℕ} {μ ν : Measure (EntireFunction m)}
    (h : μ.map ratConeValues = ν.map ratConeValues) : μ = ν := by
  ext s hs
  obtain ⟨t, ht, rfl⟩ := MeasurableSpace.measurableSet_comap.mp
    (measurableSpace_le_comap_ratConeValues s hs)
  rw [← Measure.map_apply measurable_ratConeValues ht, h,
    Measure.map_apply measurable_ratConeValues ht]

/-- Pointwise inversion of the cube. -/
def cubeInv {m : ℕ} (u : InverseCube m) : (Fin m → ℚ) → ℂ := fun q => ((u q : ℂ))⁻¹

theorem measurable_cubeInv {m : ℕ} : Measurable (cubeInv (m := m)) :=
  Measurable.of_eval fun q => (measurable_subtype_coe.comp (measurable_pi_apply q)).inv

theorem ratConeValues_ae_eq {m : ℕ} {μ : RandomEntire m} (hμ : HasInverseConeBound μ) :
    ratConeValues =ᵐ[(μ : Measure (EntireFunction m))] cubeInv ∘ inverseCubeMap := by
  have hall : ∀ᵐ F ∂(μ : Measure (EntireFunction m)),
      ∀ q : Fin m → ℚ, 1 ≤ ‖F (conePoint (ratConeParam q))‖ :=
    ae_all_iff.mpr fun q => hμ _ (ratConeParam_nonneg q)
  filter_upwards [hall] with F hF
  funext q
  simp only [ratConeValues, Function.comp_apply, cubeInv, inverseCubeMap]
  rw [clampFactor_eq (hF q)]
  simp [mixedInverseFactor]

/-- **Mixed inverse moments determine cone-bounded laws** (the `determination` field of
`EntireLawContract`): two laws with `HasInverseConeBound` and equal `mixedInverseMoment` at all
nonnegative cone points `y` and signs `σ` are equal. -/
theorem inverseMomentDetermination_field : ∀ (m : ℕ) (μ μ' : RandomEntire m),
    HasInverseConeBound μ → HasInverseConeBound μ' →
    (∀ (J : ℕ) (y : Fin J → Fin m → ℝ) (σ : Fin J → ℤˣ), (∀ j a, 0 ≤ y j a) →
      mixedInverseMoment μ y σ = mixedInverseMoment μ' y σ) → μ = μ' := by
  intro m μ μ' hμ hμ' hmom
  apply ProbabilityMeasure.toMeasure_injective
  apply measure_eq_of_map_ratConeValues_eq
  have hΦ : Measurable (inverseCubeMap (m := m)) := continuous_inverseCubeMap.measurable
  have hcube : (μ : Measure (EntireFunction m)).map inverseCubeMap =
      (μ' : Measure (EntireFunction m)).map inverseCubeMap := by
    have key (P : Measure (EntireFunction m)) (g : InverseCube m →ᵇ ℂ) :
        ∫ u, g u ∂(P.map inverseCubeMap) = ∫ F, g (inverseCubeMap F) ∂P :=
      integral_map hΦ.aemeasurable g.continuous.aestronglyMeasurable
    refine ext_of_forall_mem_subalgebra_integral_eq_of_polish (cubeAlgebra_separatesPoints m) ?_
    intro g hg
    have hg' : g ∈ Submodule.span ℂ ((Submonoid.closure
        (Set.range (cubeCoord (m := m)) ∪ star (Set.range cubeCoord))) : Set _) := by
      rw [← StarAlgebra.adjoin_eq_span]
      exact hg
    clear hg
    induction hg' using Submodule.span_induction with
    | mem g hg =>
      obtain ⟨J, y, σ, hy, hgF⟩ := exists_momentTest_of_mem_closure hg
      rw [key, key]
      simp_rw [hgF]
      rw [← mixedInverseMoment_eq_integral hμ y σ hy, ← mixedInverseMoment_eq_integral hμ' y σ hy]
      exact hmom J y σ hy
    | zero => simp
    | add g g' _ _ ihg ihg' =>
      simp only [BoundedContinuousFunction.coe_add, Pi.add_apply]
      rw [integral_add (g.integrable _) (g'.integrable _),
        integral_add (g.integrable _) (g'.integrable _), ihg, ihg']
    | smul c g _ ihg =>
      simp only [BoundedContinuousFunction.coe_smul, smul_eq_mul]
      rw [integral_const_mul, integral_const_mul, ihg]
  rw [Measure.map_congr (ratConeValues_ae_eq hμ), Measure.map_congr (ratConeValues_ae_eq hμ'),
    ← Measure.map_map measurable_cubeInv hΦ, ← Measure.map_map measurable_cubeInv hΦ, hcube]

/-- **`InverseMomentDetermination`**, with no hypothesis. -/
theorem inverseMomentDetermination : InverseMomentDetermination :=
  inverseMomentDetermination_field

/-- **The entire law with `InverseMomentDetermination` discharged**: `entireLaw_of` from
`GlobalGaussianSourceStatement`, `MatrixClosingStatement`, `FiniteGaussianMomentIdentity`,
`CollarSourceRemoval`, `ClosedSourceLimitStep` and `EntireTightness`. See
`entireLaw_of_remaining` for the version with `FiniteGaussianMomentIdentity` discharged. -/
theorem entireLaw_of_determined (hGS : BlockBand.Critical.GlobalSource.GlobalGaussianSourceStatement)
    (hMC : BlockBand.Critical.MatrixClosing.MatrixClosingStatement)
    (hO1 : FiniteGaussianMomentIdentity) (hO2 : CollarSourceRemoval)
    (hO4 : ClosedSourceLimitStep) (hO5 : EntireTightness) : EntireLawContract :=
  entireLaw_of hGS hMC hO1 hO2 hO4 hO5 inverseMomentDetermination

/-- **The entire law with `FiniteGaussianMomentIdentity` and `InverseMomentDetermination`
discharged**: from `GlobalGaussianSourceStatement`, `MatrixClosingStatement`,
`CollarSourceRemoval`, `ClosedSourceLimitStep` and `EntireTightness`. -/
theorem entireLaw_of_remaining
    (hGS : BlockBand.Critical.GlobalSource.GlobalGaussianSourceStatement)
    (hMC : BlockBand.Critical.MatrixClosing.MatrixClosingStatement)
    (hO2 : CollarSourceRemoval) (hO4 : ClosedSourceLimitStep) (hO5 : EntireTightness) :
    EntireLawContract :=
  entireLaw_of hGS hMC finiteGaussianMomentIdentity hO2 hO4 hO5 inverseMomentDetermination

end BlockBand.Critical.EntireLaw
